# Backend API base URL.
#
# DEFAULT (recommended): absolute URL to the locally-running HoYoMusic backend.
# Works in BOTH `tauri dev` and the packaged binary, because the Tauri WebView
# has no same-origin backend to proxy to. CORS on the backend is open by default.
VITE_API_BASE=http://localhost:3000/api

# Alternative for `tauri dev` only: use the relative '/api' so the Vite
# dev-server proxy (see vite.config.ts) forwards to http://localhost:3000.
# DO NOT use this for the packaged .exe — there is no Vite proxy at runtime,
# and '/api' would resolve to tauri://localhost and fail.
# VITE_API_BASE=/api

# Optional: point the Tauri webview at an external dev server instead of the bundled one.
# VITE_DEV_SERVER_URL=http://localhost:5173
