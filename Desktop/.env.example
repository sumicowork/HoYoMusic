# Backend API base URL.
# In Tauri dev, keep it as the relative '/api' so the Vite dev-server proxy
# (see vite.config.ts) forwards requests to the backend on http://localhost:3000.
VITE_API_BASE=/api

# Optional: point the Tauri webview at an external dev server instead of the bundled one.
# VITE_DEV_SERVER_URL=http://localhost:5173
