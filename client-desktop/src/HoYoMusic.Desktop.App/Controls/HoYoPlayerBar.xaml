<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoPlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PlayerBarRoot">
        <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="#10000000" BorderThickness="0,1,0,0"
                CornerRadius="14,14,0,0" Padding="16,10">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" MaxWidth="400" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- LEFT: Now Playing -->
                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6"
                            Background="{StaticResource PrimarySubtleColor}">
                        <FontIcon Glyph="&#xE8D4;" FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                                   Text="{Binding NowPlaying}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="CurrentTimeTextControl" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11" Text="0:00" FontFamily="Cascadia Mono,Consolas,monospace" />
                            <Slider x:Name="ProgressSliderControl" Minimum="0" Maximum="100" Width="100" />
                            <TextBlock x:Name="DurationTextControl" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11" Text="0:00" FontFamily="Cascadia Mono,Consolas,monospace" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- CENTER: Transport -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8EE;"
                            Style="{StaticResource TransportButtonStyle}" FontSize="14"
                            Command="{Binding TogglePlayModeCommand}"
                            ToolTipService.ToolTip="{Binding PlayModeDisplay}" />
                    <Button x:Name="PrevButtonControl" FontFamily="Segoe MDL2 Assets" Content="&#xE892;"
                            Style="{StaticResource TransportButtonStyle}" FontSize="14" />
                    <Button x:Name="PlayPauseButtonControl" Style="{StaticResource TransportPrimaryButtonStyle}">
                        <FontIcon x:Name="PlayPauseIconControl" Glyph="&#xE768;" FontSize="22" />
                    </Button>
                    <Button x:Name="NextButtonControl" FontFamily="Segoe MDL2 Assets" Content="&#xE893;"
                            Style="{StaticResource TransportButtonStyle}" FontSize="14" />
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8FD;"
                            Style="{StaticResource TransportButtonStyle}" FontSize="14"
                            ToolTipService.ToolTip="队列">
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <Border Style="{StaticResource GlassCardStyle}" MinWidth="360" MaxHeight="440" Padding="16">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="播放队列" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                                <TextBox Width="120" PlaceholderText="搜索队列"
                                                         Text="{Binding QueueFilterText, Mode=TwoWay}"
                                                         Style="{StaticResource AppTextBoxStyle}" />
                                                <Button FontFamily="Segoe MDL2 Assets" Content="&#xE712;"
                                                        Style="{StaticResource IconButtonStyle}" Width="28" Height="28">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <ToggleMenuFlyoutItem Text="过滤重复项"
                                                                IsChecked="{Binding PreventDuplicateQueueItems, Mode=TwoWay}" />
                                                            <ToggleMenuFlyoutItem Text="添加时自动播放"
                                                                IsChecked="{Binding QueueAutoPlayOnAdd, Mode=TwoWay}" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="保存为歌单"
                                                                Command="{Binding SaveQueueAsPlaylistCommand}" />
                                                            <MenuFlyoutItem Text="导出清单"
                                                                Command="{Binding ExportQueueTextCommand}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ListView Grid.Row="1" ItemsSource="{Binding PlaybackQueueView}"
                                                  Style="{StaticResource TrackListStyle}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="6" Margin="0,0,0,4" MinHeight="30">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DurationDisplay}" FontSize="11"
                                                                       Foreground="{StaticResource TextTertiaryBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="&#xE768;"
                                                                FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                Background="Transparent" BorderThickness="0" Padding="4"
                                                                Command="{Binding DataContext.PlayQueueItemByIdCommand, ElementName=PlayerBarRoot}"
                                                                CommandParameter="{Binding Id}" />
                                                        <Button Grid.Column="2" Content="&#xE712;"
                                                                FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                Background="Transparent" BorderThickness="0" Padding="4">
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem Text="上移" Icon="Up"
                                                                        Command="{Binding DataContext.MoveQueueItemUpCommand, ElementName=PlayerBarRoot}"
                                                                        CommandParameter="{Binding Id}" />
                                                                    <MenuFlyoutItem Text="下移" Icon="Down"
                                                                        Command="{Binding DataContext.MoveQueueItemDownCommand, ElementName=PlayerBarRoot}"
                                                                        CommandParameter="{Binding Id}" />
                                                                    <MenuFlyoutItem Text="移除" Icon="Delete"
                                                                        Command="{Binding DataContext.RemoveQueueItemCommand, ElementName=PlayerBarRoot}"
                                                                        CommandParameter="{Binding Id}" />
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                            <Button Content="反转" Command="{Binding ReverseQueueCommand}"
                                                    Style="{StaticResource GhostButtonStyle}" />
                                            <Button Content="打乱" Command="{Binding ShuffleQueueCommand}"
                                                    Style="{StaticResource GhostButtonStyle}" />
                                            <Button Content="清空" Command="{Binding ClearQueueCommand}"
                                                    Style="{StaticResource GhostButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <!-- RIGHT: Volume + Extras -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                    <ItemsControl ItemsSource="{Binding SpectrumBars}"
                                  Visibility="{Binding SpectrumEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalAlignment="Bottom" Height="20" Width="44">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1.5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="2.5" Height="{Binding}" CornerRadius="2"
                                        VerticalAlignment="Bottom" Background="{StaticResource SpectrumBarBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}"
                              VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSliderControl" Width="80" VerticalAlignment="Center" />
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8B0;"
                            Style="{StaticResource IconButtonStyle}" FontSize="14"
                            ToolTipService.ToolTip="曲目详情">
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <Border Style="{StaticResource GlassCardStyle}" MinWidth="340" MaxHeight="460" Padding="16">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="曲目详情" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding CurrentDetailTrack.Title}" FontWeight="SemiBold"
                                                           FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="WrapWholeWords" />
                                                <TextBlock Text="{Binding CurrentDetailTrack.ArtistsDisplay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding CurrentDetailTrack.AlbumTitle}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DetailLyricsStatus}"
                                                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding DetailLyricsPreview}"
                                                           FontSize="{Binding LyricsFontSize}" TextWrapping="WrapWholeWords"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding DetailCreditsSummary}" TextWrapping="WrapWholeWords"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding DetailMusicSourcesSummary}" TextWrapping="WrapWholeWords"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <StackPanel Grid.Row="2" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="播放" Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding PlayCurrentDetailTrackCommand}" />
                                                <Button Content="收藏" Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding ToggleFavoriteForCurrentDetailTrackCommand}" />
                                                <Button Content="加歌单" Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding AddCurrentDetailTrackToPlaylistCommand}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="展开歌词" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding ToggleLyricsPreviewExpandedCommand}" />
                                                <Button Content="字号+" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding IncreaseLyricsFontSizeCommand}" />
                                                <Button Content="字号-" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DecreaseLyricsFontSizeCommand}" />
                                                <Button Content="复制" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding CopyDetailShareTextCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE7E8;"
                            Style="{StaticResource IconButtonStyle}" FontSize="14"
                            ToolTipService.ToolTip="增强">
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <Border Style="{StaticResource GlassCardStyle}" MinWidth="320" MaxHeight="480" Padding="16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="播放器增强" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding PlayerEnhancementSummary}"
                                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" />
                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="10">
                                                <StackPanel Spacing="6">
                                                    <Grid>
                                                        <TextBlock Text="均衡器" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <ToggleSwitch IsOn="{Binding EqualizerEnabled, Mode=TwoWay}"
                                                                      HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <StackPanel Visibility="{Binding EqualizerEnabled, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="6">
                                                        <ComboBox Header="预设" ItemsSource="{Binding EqualizerPresets}"
                                                                  SelectedItem="{Binding EqualizerPreset, Mode=TwoWay}" />
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Header="低频"
                                                                     Text="{Binding EqualizerLowGain, Mode=TwoWay}"
                                                                     Style="{StaticResource AppTextBoxStyle}" />
                                                            <TextBox Grid.Column="1" Header="中频"
                                                                     Text="{Binding EqualizerMidGain, Mode=TwoWay}"
                                                                     Style="{StaticResource AppTextBoxStyle}" />
                                                            <TextBox Grid.Column="2" Header="高频"
                                                                     Text="{Binding EqualizerHighGain, Mode=TwoWay}"
                                                                     Style="{StaticResource AppTextBoxStyle}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="10">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="淡入淡出" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <Slider Value="{Binding CrossfadeSeconds, Mode=TwoWay}"
                                                                Minimum="1" Maximum="15" Width="150" />
                                                    </StackPanel>
                                                    <ToggleSwitch IsOn="{Binding CrossfadeEnabled, Mode=TwoWay}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="10">
                                                <Grid>
                                                    <TextBlock Text="频谱可视化" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <ToggleSwitch IsOn="{Binding SpectrumEnabled, Mode=TwoWay}"
                                                                  HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="睡眠定时" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Header="分钟"
                                                                 Text="{Binding SleepTimerMinutes, Mode=TwoWay}"
                                                                 Style="{StaticResource AppTextBoxStyle}" />
                                                        <Button Grid.Column="1" Content="启动"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Command="{Binding StartSleepTimerCommand}"
                                                                VerticalAlignment="Bottom" />
                                                        <Button Grid.Column="2" Content="停止"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding StopSleepTimerCommand}"
                                                                VerticalAlignment="Bottom" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Button Content="15分" Style="{StaticResource GhostButtonStyle}"
                                                                Command="{Binding ApplySleepTimerPresetCommand}"
                                                                CommandParameter="15" />
                                                        <Button Content="30分" Style="{StaticResource GhostButtonStyle}"
                                                                Command="{Binding ApplySleepTimerPresetCommand}"
                                                                CommandParameter="30" />
                                                        <Button Content="60分" Style="{StaticResource GhostButtonStyle}"
                                                                Command="{Binding ApplySleepTimerPresetCommand}"
                                                                CommandParameter="60" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="A-B 循环" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Header="A-秒"
                                                                 Text="{Binding AbLoopStartSeconds, Mode=TwoWay}"
                                                                 Style="{StaticResource AppTextBoxStyle}" />
                                                        <TextBox Grid.Column="1" Header="B-秒"
                                                                 Text="{Binding AbLoopEndSeconds, Mode=TwoWay}"
                                                                 Style="{StaticResource AppTextBoxStyle}" />
                                                        <Button Grid.Column="2" Content="启用"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Command="{Binding EnableAbLoopCommand}"
                                                                VerticalAlignment="Bottom" />
                                                    </Grid>
                                                    <Button Content="关闭" Style="{StaticResource GhostButtonStyle}"
                                                            Command="{Binding DisableAbLoopCommand}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <MediaPlayerElement x:Name="PlayerElementControl" AreTransportControlsEnabled="False"
                                    Opacity="0" IsHitTestVisible="False" Width="1" Height="1"
                                    Grid.Row="0" Grid.Column="0" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0"
                            Visibility="{Binding ShowComplianceFooter, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"
                               Text="备案：" />
                    <Button Content="{Binding ComplianceIcpNumber}" Command="{Binding OpenComplianceLinkCommand}"
                            CommandParameter="{Binding ComplianceIcpUrl}" Style="{StaticResource GhostButtonStyle}"
                            FontSize="11" Padding="4,2" />
                    <Button Content="{Binding CompliancePublicSecurityNumber}"
                            Command="{Binding OpenComplianceLinkCommand}"
                            CommandParameter="{Binding CompliancePublicSecurityUrl}"
                            Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="4,2" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
