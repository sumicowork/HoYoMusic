<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoPlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Grid x:Name="PlayerBarRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"
                CornerRadius="{StaticResource RadiusPlayer}" Padding="16,8">
            <Grid ColumnSpacing="{StaticResource GapLG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="180" />
                    <ColumnDefinition Width="*" MaxWidth="500" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ═══ LEFT: Now Playing ═══ -->
                <Grid Grid.Column="0" ColumnSpacing="{StaticResource Gap10}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Cover art -->
                    <Border Grid.Column="0" Width="{StaticResource CoverArtPlayer}" Height="{StaticResource CoverArtPlayer}"
                            CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource PrimarySubtleBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconCoverPlaceholderSmall}" Foreground="{StaticResource PrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="{StaticResource RadiusSM}">
                                <Image Source="{Binding CurrentDetailTrack.CoverPath}" Stretch="UniformToFill" />
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Track info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Gap2}">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Text="{Binding NowPlaying}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSmall}"
                                   Text="{Binding CurrentDetailTrack.ArtistsDisplay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- ═══ CENTER: Transport Controls + Progress ═══ -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Gap6}">
                    <!-- Transport buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource GapSM}">
                        <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8EE;"
                                Style="{StaticResource TransportButtonStyle}" FontSize="{StaticResource IconActionSize}"
                                Command="{Binding TogglePlayModeCommand}"
                                ToolTipService.ToolTip="{Binding PlayModeDisplay}" AutomationProperties.Name="切换播放模式" />
                        <Button x:Name="PrevButtonControl" FontFamily="Segoe MDL2 Assets" Content="&#xE892;"
                                Style="{StaticResource TransportButtonStyle}" FontSize="18" AutomationProperties.Name="上一首" />
                        <Button x:Name="PlayPauseButtonControl" Style="{StaticResource TransportPrimaryButtonStyle}" AutomationProperties.Name="播放暂停">
                            <FontIcon x:Name="PlayPauseIconControl" Glyph="&#xE768;" FontSize="{StaticResource IconPlayPauseSize}" />
                        </Button>
                        <Button x:Name="NextButtonControl" FontFamily="Segoe MDL2 Assets" Content="&#xE893;"
                                Style="{StaticResource TransportButtonStyle}" FontSize="18" AutomationProperties.Name="下一首" />
                        <!-- Queue toggle (opens drawer) -->
                        <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8FD;"
                                Style="{StaticResource TransportButtonStyle}" FontSize="{StaticResource IconActionSize}"
                                ToolTipService.ToolTip="播放队列" AutomationProperties.Name="播放队列"
                                Command="{Binding DataContext.OpenDrawerCommand, ElementName=PlayerBarRoot}"
                                CommandParameter="queue" />
                    </StackPanel>
                    <!-- Progress bar -->
                    <Grid ColumnSpacing="{StaticResource GapSM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentTimeTextControl" Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="{StaticResource FontSmall}" Text="0:00" FontFamily="Cascadia Mono,Consolas,monospace"
                                   VerticalAlignment="Center" MinWidth="36" />
                        <Slider x:Name="ProgressSliderControl" Grid.Column="1" Minimum="0" Maximum="100"
                                AutomationProperties.Name="播放进度" />
                        <TextBlock x:Name="DurationTextControl" Grid.Column="2" Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="{StaticResource FontSmall}" Text="0:00" FontFamily="Cascadia Mono,Consolas,monospace"
                                   VerticalAlignment="Center" MinWidth="36" />
                    </Grid>
                </StackPanel>

                <!-- ═══ RIGHT: Volume + Extras ═══ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{StaticResource Gap6}">
                    <!-- Spectrum bars -->
                    <ItemsControl ItemsSource="{Binding SpectrumBars}"
                                  Visibility="{Binding SpectrumEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalAlignment="Bottom" Height="20" Width="44">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1.5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="2.5" Height="{Binding}" CornerRadius="2"
                                        VerticalAlignment="Bottom" Background="{StaticResource SpectrumBarBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Volume -->
                    <FontIcon Glyph="&#xE767;" FontSize="{StaticResource IconActionSize}" Foreground="{StaticResource TextTertiaryBrush}"
                              VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSliderControl" Width="90" VerticalAlignment="Center" AutomationProperties.Name="音量控制" />
                    <!-- Now Playing drawer toggle -->
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8B0;"
                            Style="{StaticResource IconButtonStyle}" FontSize="{StaticResource IconActionSize}"
                            ToolTipService.ToolTip="曲目详情" AutomationProperties.Name="曲目详情"
                            Command="{Binding DataContext.OpenDrawerCommand, ElementName=PlayerBarRoot}"
                            CommandParameter="now-playing" />
                    <!-- Enhancements drawer toggle -->
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE7E8;"
                            Style="{StaticResource IconButtonStyle}" FontSize="{StaticResource IconActionSize}"
                            ToolTipService.ToolTip="播放器增强" AutomationProperties.Name="播放器增强"
                            Command="{Binding DataContext.OpenDrawerCommand, ElementName=PlayerBarRoot}"
                            CommandParameter="enhancements" />
                    <!-- Hidden MediaPlayerElement -->
                    <MediaPlayerElement x:Name="PlayerElementControl" AreTransportControlsEnabled="False"
                                        Opacity="0" IsHitTestVisible="False" Width="1" Height="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compliance footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource Gap6}" Margin="16,2,16,4"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ShowComplianceFooter, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSmall}"
                       Text="备案：" />
            <Button Content="{Binding ComplianceIcpNumber}" Command="{Binding OpenComplianceLinkCommand}"
                    CommandParameter="{Binding ComplianceIcpUrl}" Style="{StaticResource MicroButtonStyle}" />
            <Button Content="{Binding CompliancePublicSecurityNumber}"
                    Command="{Binding OpenComplianceLinkCommand}"
                    CommandParameter="{Binding CompliancePublicSecurityUrl}"
                    Style="{StaticResource MicroButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
