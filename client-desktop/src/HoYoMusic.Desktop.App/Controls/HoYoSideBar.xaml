<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoSideBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource GlassCardStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock x:Name="SideBarText" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" Text="探索" />
                <ListView
                    ItemsSource="{Binding Games}"
                    SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    MinHeight="260"
                    Width="60"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ListViewItemPresenter
                                            Padding="0"
                                            ContentMargin="0"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            SelectionCheckMarkVisualEnabled="False" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="48" Height="48" Margin="0,0,0,8" ToolTipService.ToolTip="{Binding DisplayName}">
                                <!-- Base fallback style so it's not totally empty when no cover -->
                                <Border CornerRadius="12" Background="{StaticResource PrimaryGradientBrush}" Opacity="0.1" />
                                <FontIcon Glyph="&#xE7FC;" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- The actual game cover without heavy borders -->
                                <Border CornerRadius="12">
                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" ImageOpened="GameCoverImage_OnImageOpened" ImageFailed="GameCoverImage_OnImageFailed" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>