<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoSideBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6">
            <TextBlock x:Name="SideBarText" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"
                       Text="探索" Margin="0,4,0,8" />
            <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                      SelectionMode="Single" IsItemClickEnabled="True"
                      Width="66" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ListViewItemPresenter Padding="0" ContentMargin="0"
                                        HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        SelectionCheckMarkVisualEnabled="False"
                                        SelectedBackground="#146366F1"
                                        SelectedForeground="{StaticResource TextPrimaryBrush}"
                                        PointerOverBackground="#086366F1"
                                        CornerRadius="12" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="52" Height="52" Margin="0,0,0,4" ToolTipService.ToolTip="{Binding DisplayName}">
                            <Border CornerRadius="12" Background="{StaticResource PrimarySubtleColor}" />
                            <FontIcon Glyph="&#xE7FC;" Foreground="{StaticResource TextTertiaryBrush}"
                                      FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="12">
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                                       ImageOpened="GameCoverImage_OnImageOpened"
                                       ImageFailed="GameCoverImage_OnImageFailed" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
