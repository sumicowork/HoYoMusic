<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoSideBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HoYoMusic.Desktop.App.Controls">
    <Grid x:Name="SideBarRoot" Background="{StaticResource SurfaceCardBrush}" CornerRadius="{StaticResource RadiusLG}"
          Padding="6,8,6,8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Section 1: Main Navigation ═══ -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource Gap2}">
            <Button x:Name="DiscoverButton" Tag="discover" Click="NavButton_OnClick"
                    Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="发现">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE7FC;" FontSize="{StaticResource IconNavBarSize}" />
                    <TextBlock x:Name="DiscoverLabel" Text="发现" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="LibraryButton" Tag="library" Click="NavButton_OnClick"
                    Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="曲库">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconNavBarSize}" />
                    <TextBlock x:Name="LibraryLabel" Text="曲库" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SearchButton" Tag="search" Click="NavButton_OnClick"
                    Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="搜索">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconNavBarSize}" />
                    <TextBlock x:Name="SearchLabel" Text="搜索" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ═══ Section 2: Browse Sub-nav ═══ -->
        <StackPanel Grid.Row="1" Spacing="{StaticResource Gap2}" Margin="0,12,0,4"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <TextBlock x:Name="BrowseLabel" Text="浏览" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiaryBrush}" Margin="8,0,0,4" />
            <Button x:Name="RecommendedSubButton" Tag="discover" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE753;" FontSize="14" />
                    <TextBlock x:Name="DiscoverSubLabel" Text="推荐" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="GamesSubButton" Tag="games" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                    <TextBlock x:Name="GamesSubLabel" Text="游戏" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="AlbumsSubButton" Tag="albums" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE93C;" FontSize="14" />
                    <TextBlock x:Name="AlbumsSubLabel" Text="专辑" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="ArtistsSubButton" Tag="artists" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE77B;" FontSize="14" />
                    <TextBlock x:Name="ArtistsSubLabel" Text="艺人" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="TagsSubButton" Tag="tags" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                    <TextBlock x:Name="TagsSubLabel" Text="标签" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ═══ Section 3: Games Library ═══ -->
        <Grid Grid.Row="2" Margin="0,8,0,4"
              BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="GamesHeaderLabel" Grid.Row="0" Text="游戏" FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiaryBrush}" Margin="8,0,0,6" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                          SelectionMode="Single" IsItemClickEnabled="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ListViewItemPresenter Padding="{TemplateBinding Padding}" ContentMargin="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            SelectionCheckMarkVisualEnabled="False"
                                            SelectedBackground="{StaticResource SidebarSelectedBrush}"
                                            SelectedForeground="{StaticResource TextPrimaryBrush}"
                                            PointerOverBackground="{StaticResource SidebarHoverBrush}"
                                            CornerRadius="{StaticResource RadiusSM}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="{StaticResource GapSM}" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource RadiusSM}"
                                        Background="{StaticResource PrimarySubtleBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE7FC;" Foreground="{StaticResource TextTertiaryBrush}"
                                                  FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="{StaticResource RadiusSM}">
                                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                                                   ImageOpened="GameCoverImage_OnImageOpened"
                                                   ImageFailed="GameCoverImage_OnImageFailed" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontCaption}"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="{StaticResource FontSmall}"
                                               Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding StatusDisplay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>

        <!-- ═══ Section 4: Footer Navigation ═══ -->
        <StackPanel Grid.Row="3" Spacing="{StaticResource Gap2}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <Button x:Name="FavoritesButton" Tag="favorites" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{StaticResource ErrorBrush}" />
                    <TextBlock x:Name="FavoritesLabel" Text="收藏" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="PlaylistsButton" Tag="playlists" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    <TextBlock x:Name="PlaylistsLabel" Text="歌单" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="DownloadsButton" Tag="downloads" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock x:Name="DownloadsLabel" Text="下载" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Tag="settings" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock x:Name="SettingsLabel" Text="设置" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="AdminButton" Tag="admin" Click="NavButton_OnClick" Style="{StaticResource NavButtonStyle}" FontSize="{StaticResource FontCaption}"
                    Visibility="{Binding ShowAdminEntry, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                    <TextBlock x:Name="AdminLabel" Text="管理后台" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
