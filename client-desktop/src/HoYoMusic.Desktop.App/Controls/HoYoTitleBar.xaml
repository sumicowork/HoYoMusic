<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="TitleBarRoot" Height="44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left: Brand -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource GapSM}" VerticalAlignment="Center">
            <Border Width="10" Height="10" CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource PrimaryGradientBrush}" />
            <TextBlock FontSize="{StaticResource FontSubtitleSM}" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Text="HoYoMusic" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Center: Drag Region (transparent area for window dragging) -->
        <Border Grid.Column="1" x:Name="DragRegionFill" Background="Transparent" />

        <!-- Right: Action buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource GapXS}" VerticalAlignment="Center">
            <!-- Keyboard shortcuts -->
            <Button FontFamily="Segoe MDL2 Assets" Content="&#xE765;" FontSize="{StaticResource IconNavBarSize}"
                    Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="快捷键" AutomationProperties.Name="快捷键帮助">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Border Style="{StaticResource GlassCardStyle}" MinWidth="240" Padding="{StaticResource PaddingLG}">
                            <StackPanel Spacing="{StaticResource Gap6}">
                                <TextBlock Text="快捷键" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Space — 播放/暂停" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                                <TextBlock Text="← → — 上一首/下一首" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                                <TextBlock Text="Ctrl+← → — 快退/快进 5 秒" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                                <TextBlock Text="↑ ↓ — 音量增减" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                                <TextBlock Text="M — 静音" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                                <TextBlock Text="L — 切换播放模式" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                                <TextBlock Text="Esc — 返回" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Inbox (opens drawer) -->
            <Grid>
                <Button FontFamily="Segoe MDL2 Assets" Content="&#xE715;" FontSize="{StaticResource IconNavBarSize}"
                        Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="收件箱" AutomationProperties.Name="收件箱"
                        Command="{Binding OpenDrawerCommand}" CommandParameter="inbox" />
                <!-- Unread badge -->
                <Border Background="{StaticResource ErrorBrush}" CornerRadius="{StaticResource RadiusFull}"
                        MinWidth="16" MinHeight="16" Padding="4,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                        Visibility="{Binding HasUnreadMessages, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding UnreadMessageCount}" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextInverseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Account (opens drawer) -->
            <Button FontFamily="Segoe MDL2 Assets" Content="&#xE77B;" FontSize="{StaticResource IconNavBarSize}"
                    Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{Binding CurrentUserDisplay}"
                    AutomationProperties.Name="账户中心"
                    Command="{Binding OpenDrawerCommand}" CommandParameter="account" />
        </StackPanel>
    </Grid>
</UserControl>
