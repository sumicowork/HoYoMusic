<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="TitleBarRoot">
        <Border Style="{StaticResource GlassCardStyle}" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource PrimaryGradientBrush}" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="HoYoMusic" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="游戏音乐档案馆" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="18" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="快捷键帮助" AutomationProperties.HelpText="显示全局快捷键列表">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Style="{StaticResource GlassCardStyle}" MinWidth="300">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="快捷键帮助" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Space: 播放/暂停" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Left/Right: 上一首/下一首" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="M: 静音切换" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="L: 切换播放模式" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Esc: 返回发现页" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="18" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="收件箱" AutomationProperties.HelpText="查看未读消息和通知">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Style="{StaticResource GlassCardStyle}" MinWidth="420" MaxHeight="520">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="刷新" Command="{Binding RefreshInboxCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Content="全部已读" Command="{Binding MarkAllMessagesReadCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            <ToggleSwitch Header="仅未读" IsOn="{Binding ShowUnreadOnly, Mode=TwoWay}" Toggled="InboxFilter_OnToggled" />
                                            <TextBox Width="140" PlaceholderText="搜索消息" Text="{Binding MessageSearchText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        </StackPanel>
                                        <InfoBar Grid.Row="1" IsClosable="False" Severity="Informational" Message="{Binding InboxStatusMessage}" IsOpen="{Binding ShowInboxStatus}" />
                                        <Grid Grid.Row="2" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ListView Grid.Row="0" ItemsSource="{Binding InboxMessages}" Style="{StaticResource TrackListStyle}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource SubtleGlassCardStyle}" Margin="0,0,0,8" Padding="10">
                                                            <Grid RowSpacing="6">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                                    <Button Grid.Column="1" Content="已读" Command="{Binding DataContext.MarkMessageReadCommand, ElementName=TitleBarRoot}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Text="{Binding Content}" TextWrapping="WrapWholeWords" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <TextBlock Grid.Row="2" Text="{Binding Meta}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                <Button Content="上一页" Command="{Binding PreviousInboxPageCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding HasPreviousInboxPage}" />
                                                <TextBlock Text="{Binding InboxPaginationSummary}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Button Content="下一页" Command="{Binding NextInboxPageCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding HasNextInboxPage}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="账户中心" AutomationProperties.HelpText="管理登录和个人信息">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Style="{StaticResource GlassCardStyle}" MinWidth="380">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="账户中心" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource PrimaryGradientBrush}" Text="{Binding CurrentUserDisplay}" VerticalAlignment="Center" />
                                        </Grid>
                                        
                                        <Pivot>
                                            <PivotItem Header="登录" Margin="0,10,0,0">
                                                <StackPanel Spacing="12">
                                                    <TextBox Header="账号" PlaceholderText="输入邮箱或用户名" Text="{Binding Identifier, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    <PasswordBox x:Name="PasswordInput" Header="密码" PlaceholderText="输入密码" PasswordChanged="PasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                                    <Grid Margin="0,8,0,0">
                                                        <Button HorizontalAlignment="Left" Content="退出登录" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                        <Button HorizontalAlignment="Right" Content="立刻登录" Click="LoginButton_OnClick" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" />
                                                    </Grid>
                                                </StackPanel>
                                            </PivotItem>
                                            
                                            <PivotItem Header="注册" Margin="0,10,0,0">
                                                <StackPanel Spacing="12">
                                                    <TextBox Header="用户名" PlaceholderText="设置常用昵称" Text="{Binding RegisterUsername, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    <TextBox Header="邮箱" PlaceholderText="用于找回密码" Text="{Binding RegisterEmail, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Header="验证码" PlaceholderText="6位代码" Text="{Binding VerificationCode, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                        <Button Grid.Column="2" Content="获取验证码" Command="{Binding SendVerificationCodeCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Height="32" />
                                                    </Grid>
                                                    <PasswordBox x:Name="RegisterPasswordInput" Header="密码" PlaceholderText="设置密码" PasswordChanged="RegisterPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                                    <PasswordBox x:Name="RegisterConfirmPasswordInput" Header="确认密码" PlaceholderText="再次输入密码" PasswordChanged="RegisterConfirmPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                                    <Button HorizontalAlignment="Right" Content="注册并登录" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </PivotItem>
                                            
                                            <PivotItem Header="安全" Margin="0,10,0,0">
                                                <StackPanel Spacing="12">
                                                    <PasswordBox x:Name="CurrentPasswordInput" Header="当前密码" PlaceholderText="验证身份" PasswordChanged="CurrentPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                                    <PasswordBox x:Name="NewPasswordInput" Header="新密码" PlaceholderText="设置新密码" PasswordChanged="NewPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                                    <Button HorizontalAlignment="Right" Content="保存修改" Command="{Binding ChangePasswordCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </PivotItem>
                                        </Pivot>
                                        
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

