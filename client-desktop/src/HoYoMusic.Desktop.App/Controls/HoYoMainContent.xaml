                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="播放与队列" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Header="队列去重" IsOn="{Binding PreventDuplicateQueueItems, Mode=TwoWay}" />
                            <ToggleSwitch Header="加入队列后自动播放" IsOn="{Binding QueueAutoPlayOnAdd, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="15分睡眠" Command="{Binding ApplySleepTimerPresetCommand}" CommandParameter="15" Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="30分睡眠" Command="{Binding ApplySleepTimerPresetCommand}" CommandParameter="30" Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="60分睡眠" Command="{Binding ApplySleepTimerPresetCommand}" CommandParameter="60" Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="反馈" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox Header="联系方式(可选)" Text="{Binding FeedbackContact, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                            <TextBox Header="反馈内容" Text="{Binding FeedbackContent, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Style="{StaticResource AppTextBoxStyle}" />
                            <Button Content="提交反馈" Command="{Binding SubmitFeedbackCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════ DOWNLOADS VIEW ═══════ -->
            <ScrollViewer x:Name="DownloadsViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock Text="下载中心" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="刷新" Command="{Binding RefreshDownloadCenterCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="全部取消" Command="{Binding CancelAllDownloadsCommand}" Style="{StaticResource GhostButtonStyle}" />
                        <TextBox Width="160" PlaceholderText="搜索任务" Text="{Binding DownloadSearchText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                        <ComboBox Width="120" SelectedItem="{Binding DownloadStatusFilter, Mode=TwoWay}">
                            <x:String>all</x:String><x:String>Queued</x:String><x:String>Downloading</x:String><x:String>Completed</x:String><x:String>Failed</x:String>
                        </ComboBox>
                    </StackPanel>
                    <ListView ItemsSource="{Binding DownloadTasks}" Style="{StaticResource TrackListStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubtleGlassCardStyle}" Margin="0,0,0,6" Padding="10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                            <Button Content="取消" FontSize="11" Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.CancelDownloadCommand, ElementName=MainContentRoot}" CommandParameter="{Binding Id}" />
                                            <Button Content="重试" FontSize="11" Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.RetryFailedDownloadCommand, ElementName=MainContentRoot}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
