<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoMainContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Grid x:Name="MainContentRoot" RowSpacing="{StaticResource Gap10}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER: Section Title ═══ -->
        <Grid Grid.Row="0" Padding="4,4,4,0">
            <StackPanel>
                <TextBlock FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding CurrentSectionTitle}" />
                <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontCaption}"
                           Text="{Binding CurrentSectionSubtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Info & status bars -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource Gap2}" VerticalAlignment="Bottom" Margin="0,48,0,0">
            <InfoBar IsClosable="False" Severity="Error" Message="{Binding ErrorMessage}" IsOpen="{Binding HasErrorMessage}" />
            <InfoBar IsClosable="True" Severity="Success" Message="{Binding SuccessMessage}" IsOpen="{Binding ShowSuccessMessage}" CloseButtonClick="SuccessInfoBar_OnClose" />
            <ProgressBar IsIndeterminate="True" Height="2"
                         Visibility="{Binding ShowGlobalBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="0,6,0,0">

            <!-- ═══════════════════════════════════════════════════════════════
                 BROWSE VIEW — Discover / Games / Albums / Artists / Tags / Detail
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="BrowseViewPanel" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource Gap2XL}" Padding="4,0,12,32">

                    <!-- ═══ DISCOVER ═══ -->
                    <StackPanel x:Name="DiscoverContent" Visibility="Visible" Spacing="{StaticResource Gap2XL}">

                        <!-- ── Hero Banner ── -->
                        <Border Style="{StaticResource HeroCardStyle}" MinHeight="160">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource GapSM}" VerticalAlignment="Center">
                                    <TextBlock FontSize="{StaticResource FontDisplay}" FontWeight="Bold"
                                               Foreground="{StaticResource TextInverseBrush}"
                                               Text="发现音乐" />
                                    <TextBlock FontSize="{StaticResource FontSubtitleLG}" Foreground="#CCFFFFFF"
                                               Text="浏览游戏原声、专辑与精选曲目" TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapLG}" Margin="0,8,0,0">
                                        <StackPanel Spacing="{StaticResource Gap2}">
                                            <TextBlock FontSize="{StaticResource FontTitle}" FontWeight="Bold" Foreground="{StaticResource TextInverseBrush}"
                                                       Text="{Binding Games.Count, FallbackValue=0}" />
                                            <TextBlock FontSize="{StaticResource FontCaption}" Foreground="#99FFFFFF" Text="游戏" />
                                        </StackPanel>
                                        <Border Width="1" Background="#33FFFFFF" Margin="0,4,0,4" />
                                        <StackPanel Spacing="{StaticResource Gap2}">
                                            <TextBlock FontSize="{StaticResource FontTitle}" FontWeight="Bold" Foreground="{StaticResource TextInverseBrush}"
                                                       Text="{Binding SelectedGameAlbums.Count, FallbackValue=0}" />
                                            <TextBlock FontSize="{StaticResource FontCaption}" Foreground="#99FFFFFF" Text="专辑" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Decorative music icon -->
                                <FontIcon Grid.Column="1" Glyph="&#xE8D4;" FontSize="80" Foreground="#15FFFFFF"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </Grid>
                        </Border>

                        <!-- ── Game Selector ── -->
                        <StackPanel Spacing="{StaticResource GapLG}">
                            <!-- Section header with accent indicator -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="选择游戏" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Card with shadow -->
                            <Grid>
                                <Border Style="{StaticResource CardShadowStyle}" />
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                              Style="{StaticResource TrackListStyle}" MaxHeight="200" Padding="{StaticResource PaddingSM}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="{StaticResource Gap14}" Margin="4,4,4,4" MinHeight="44">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40"
                                                            CornerRadius="{StaticResource RadiusMD}" Background="{StaticResource CoverPlaceholderBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE7FC;" FontSize="{StaticResource IconCoverPlaceholderSmall}"
                                                                      Foreground="{StaticResource PrimaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border CornerRadius="{StaticResource RadiusMD}">
                                                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="{StaticResource FontSmall}"
                                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ── Albums Section ── -->
                        <StackPanel Spacing="{StaticResource GapLG}">
                            <!-- Section header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="专辑" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <ListView ItemsSource="{Binding SelectedGameAlbums}"
                                      SelectedItem="{Binding SelectedGameAlbum, Mode=TwoWay}"
                                      SelectionMode="Single" IsItemClickEnabled="True"
                                      ItemClick="DiscoverAlbumsList_OnItemClick"
                                      Style="{StaticResource TrackListStyle}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="180" Margin="0,0,14,0">
                                            <Border Style="{StaticResource CardShadowStyle}" />
                                            <Border Style="{StaticResource GlassCardStyle}" Padding="0,0,0,10">
                                                <StackPanel Spacing="{StaticResource Gap6}">
                                                    <!-- Cover art with rounded corners -->
                                                    <Border CornerRadius="{StaticResource RadiusMD}" Height="164"
                                                            Background="{StaticResource CoverPlaceholderBrush}" Margin="8,8,8,2">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconCoverPlaceholderLarge}"
                                                                      Foreground="{StaticResource PrimaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border CornerRadius="{StaticResource RadiusMD}">
                                                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                               Margin="10,0,10,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- ── Tracks: Random + Top side by side ── -->
                        <StackPanel Spacing="{StaticResource GapLG}">
                            <!-- Section header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="推荐曲目" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource GapLG}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Random tracks card -->
                                <Grid>
                                    <Border Style="{StaticResource CardShadowStyle}" />
                                    <Border Style="{StaticResource GlassCardStyle}">
                                        <StackPanel Padding="{StaticResource PaddingXL}" Spacing="{StaticResource GapMD}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                                <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusFull}"
                                                        Background="{StaticResource PrimarySubtleBrush}">
                                                    <FontIcon Glyph="&#xE8B1;" FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="随机推荐" FontSize="{StaticResource FontSubtitleSM}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ListView ItemsSource="{Binding RandomTracksView}" Style="{StaticResource TrackListStyle}" MaxHeight="320">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,2,2,2" MinHeight="38">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Left accent bar -->
                                                            <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                                    Background="{StaticResource AccentGradientBrush}"
                                                                    VerticalAlignment="Stretch" Margin="0,6,0,6" />
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding AlbumTitle}" FontSize="{StaticResource FontSmall}"
                                                                           Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- Top tracks card -->
                                <Grid Grid.Column="1">
                                    <Border Style="{StaticResource CardShadowStyle}" />
                                    <Border Style="{StaticResource GlassCardStyle}">
                                        <StackPanel Padding="{StaticResource PaddingXL}" Spacing="{StaticResource GapMD}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                                <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusFull}"
                                                        Background="{StaticResource AccentSubtleBrush}">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="热门曲目" FontSize="{StaticResource FontSubtitleSM}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ListView ItemsSource="{Binding TopTracksView}" Style="{StaticResource TrackListStyle}" MaxHeight="320">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,2,2,2" MinHeight="38">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    VerticalAlignment="Stretch" Margin="0,6,0,6" />
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding AlbumTitle}" FontSize="{StaticResource FontSmall}"
                                                                           Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══ GAMES ═══ -->
                    <StackPanel x:Name="GamesContent" Visibility="Collapsed" Spacing="{StaticResource GapXL}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="游戏列表" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                          Style="{StaticResource TrackListStyle}" Padding="{StaticResource PaddingSM}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="{StaticResource Gap14}" Margin="4,4,4,4" MinHeight="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="44" Height="44"
                                                        CornerRadius="{StaticResource RadiusMD}" Background="{StaticResource CoverPlaceholderBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE7FC;" FontSize="{StaticResource IconCoverPlaceholderSmall}"
                                                                  Foreground="{StaticResource PrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border CornerRadius="{StaticResource RadiusMD}">
                                                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="{StaticResource FontSmall}"
                                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ ALBUMS ═══ -->
                    <StackPanel x:Name="AlbumsContent" Visibility="Collapsed" Spacing="{StaticResource GapXL}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="专辑列表" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <ListView ItemsSource="{Binding SelectedGameAlbums}" Style="{StaticResource TrackListStyle}"
                                  IsItemClickEnabled="True" ItemClick="DiscoverAlbumsList_OnItemClick"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="170" Margin="0,0,12,0">
                                        <Border Style="{StaticResource CardShadowStyle}" />
                                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="0,0,0,10">
                                            <StackPanel Spacing="{StaticResource Gap6}">
                                                <Border CornerRadius="{StaticResource RadiusMD}" Height="156"
                                                        Background="{StaticResource CoverPlaceholderBrush}" Margin="7,7,7,2">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconCoverPlaceholderLarge}"
                                                                  Foreground="{StaticResource PrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border CornerRadius="{StaticResource RadiusMD}">
                                                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontCaption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                           Margin="9,0,9,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- ═══ ARTISTS ═══ -->
                    <StackPanel x:Name="ArtistsContent" Visibility="Collapsed" Spacing="{StaticResource GapXL}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="艺人列表" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <ListView ItemsSource="{Binding ArtistFacetItems}" Style="{StaticResource TrackListStyle}"
                                          AutomationProperties.Name="艺人列表" Padding="{StaticResource PaddingSM}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3,4,3" MinHeight="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                        Background="{StaticResource AccentGradientBrush}"
                                                        VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                                <Border Grid.Column="2" Width="40" Height="40" CornerRadius="{StaticResource RadiusFull}"
                                                        Background="{StaticResource CoverPlaceholderBrush}">
                                                    <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSmall}"
                                                               Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ TAGS ═══ -->
                    <StackPanel x:Name="TagsContent" Visibility="Collapsed" Spacing="{StaticResource GapXL}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="标签列表" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <ListView ItemsSource="{Binding TagFacetItems}" Style="{StaticResource TrackListStyle}"
                                          AutomationProperties.Name="标签列表" Padding="{StaticResource PaddingSM}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3,4,3" MinHeight="44">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                        Background="{StaticResource AccentGradientBrush}"
                                                        VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                                <Border Grid.Column="2" Width="32" Height="32" CornerRadius="{StaticResource RadiusFull}"
                                                        Background="{StaticResource CoverPlaceholderBrush}">
                                                    <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSmall}"
                                                               Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ ALBUM DETAIL ═══ -->
                    <StackPanel x:Name="AlbumDetailContent" Visibility="Collapsed" Spacing="{StaticResource Gap2XL}">
                        <Button Content="&#xE72B; 返回" Tag="discover" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" />

                        <!-- Hero card with large cover -->
                        <Border Style="{StaticResource HeroCardStyle}" MinHeight="180">
                            <Grid ColumnSpacing="{StaticResource Gap2XL}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="140" Height="140" CornerRadius="{StaticResource RadiusXL}"
                                        Background="{StaticResource CoverPlaceholderBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D4;" FontSize="40" Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="{StaticResource RadiusXL}">
                                            <Image Source="{Binding CurrentAlbum.CoverPath}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Gap6}">
                                    <TextBlock Text="专辑" FontSize="{StaticResource FontCaption}" FontWeight="Medium"
                                               Foreground="#99FFFFFF" />
                                    <TextBlock Text="{Binding CurrentAlbum.Title}" FontSize="{StaticResource FontDisplay}" FontWeight="Bold"
                                               Foreground="{StaticResource TextInverseBrush}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Foreground="#BBFFFFFF" FontSize="{StaticResource FontSubtitle}"
                                               Text="浏览专辑曲目" />
                                    <Button Content="&#xE768; 播放全部" Command="{Binding PlayAlbumAllCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Track list -->
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <ListView ItemsSource="{Binding AlbumTrackRows}" Style="{StaticResource TrackListStyle}"
                                          IsItemClickEnabled="True" ItemClick="AlbumTrackList_OnItemClick" Padding="{StaticResource PaddingSM}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3,4,3" MinHeight="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                        Background="{StaticResource AccentGradientBrush}"
                                                        VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                                <TextBlock Grid.Column="2" Text="{Binding PlayingIndicator}"
                                                           Foreground="{StaticResource PrimaryBrush}" FontSize="{StaticResource FontSmall}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ArtistsDisplay}" FontSize="{StaticResource FontSmall}"
                                                               Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding DurationDisplay}" FontSize="{StaticResource FontSmall}"
                                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ TRACK DETAIL ═══ -->
                    <StackPanel x:Name="TrackDetailContent" Visibility="Collapsed" Spacing="{StaticResource Gap2XL}">
                        <Button Content="&#xE72B; 返回" Tag="discover" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" />

                        <!-- Hero card -->
                        <Border Style="{StaticResource HeroCardStyle}" MinHeight="180">
                            <Grid ColumnSpacing="{StaticResource Gap2XL}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="140" Height="140" CornerRadius="{StaticResource RadiusXL}"
                                        Background="{StaticResource CoverPlaceholderBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D4;" FontSize="40" Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="{StaticResource RadiusXL}">
                                            <Image Source="{Binding CurrentDetailTrack.CoverPath}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Gap6}">
                                    <TextBlock Text="曲目" FontSize="{StaticResource FontCaption}" FontWeight="Medium"
                                               Foreground="#99FFFFFF" />
                                    <TextBlock Text="{Binding CurrentDetailTrack.Title}" FontSize="{StaticResource FontDisplay}" FontWeight="Bold"
                                               Foreground="{StaticResource TextInverseBrush}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{Binding CurrentDetailTrack.ArtistsDisplay}"
                                               Foreground="#CCFFFFFF" FontSize="{StaticResource FontSubtitle}" />
                                    <TextBlock Text="{Binding CurrentDetailTrack.AlbumTitle}"
                                               Foreground="#99FFFFFF" FontSize="{StaticResource FontBody}" />
                                    <TextBlock Text="{Binding CurrentDetailTrack.DurationDisplay}"
                                               Foreground="#88FFFFFF" FontSize="{StaticResource FontCaption}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action buttons -->
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <Button Content="&#xE768; 播放" Command="{Binding PlayCurrentDetailTrackCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="&#xE735; 收藏" Command="{Binding ToggleFavoriteForCurrentDetailTrackCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                                    <Button Content="&#xE710; 加到歌单" Command="{Binding AddCurrentDetailTrackToPlaylistCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                                    <Button Content="&#xE896; 下载" Command="{Binding DownloadCurrentDetailTrackCommand}"
                                            Style="{StaticResource GhostButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Lyrics -->
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel Padding="{StaticResource PaddingXL}" Spacing="{StaticResource GapMD}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="歌词" FontSize="{StaticResource FontSubtitleSM}" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding DetailLyricsPreview}" FontSize="{StaticResource FontBody}"
                                               LineHeight="{StaticResource LineHeightSubtitle}"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Credits summary -->
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource Gap6}">
                                <TextBlock Text="{Binding DetailCreditsSummary}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                                <TextBlock Text="{Binding DetailMusicSourcesSummary}"
                                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSmall}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════════
                 LIBRARY VIEW
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="LibraryViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource Gap2XL}" Padding="4,0,12,32">

                    <!-- Library tab -->
                    <StackPanel x:Name="LibraryTabContent" Visibility="Visible" Spacing="{StaticResource GapXL}">
                        <!-- Filter bar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="筛选条件" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Width="200" PlaceholderText="搜索" Text="{Binding SearchKeyword, Mode=TwoWay}"
                                             Style="{StaticResource AppTextBoxStyle}" />
                                    <ComboBox Width="100" SelectedItem="{Binding DurationBucket, Mode=TwoWay}" Style="{StaticResource AppComboBoxStyle}">
                                        <x:String></x:String><x:String>short</x:String><x:String>medium</x:String><x:String>long</x:String>
                                    </ComboBox>
                                    <ComboBox Width="100" SelectedItem="{Binding LyricsStatus, Mode=TwoWay}" Style="{StaticResource AppComboBoxStyle}">
                                        <x:String></x:String><x:String>has_lyrics</x:String><x:String>instrumental</x:String><x:String>none</x:String>
                                    </ComboBox>
                                    <Button Content="搜索" Command="{Binding SearchPublicTracksCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="重置" Command="{Binding ResetLibraryFiltersCommand}"
                                            Style="{StaticResource GhostButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Track list -->
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <StackPanel Spacing="{StaticResource GapSM}">
                                    <ListView ItemsSource="{Binding PublicTracks}" SelectedItem="{Binding SelectedPublicTrack, Mode=TwoWay}"
                                              Style="{StaticResource TrackListStyle}" Padding="{StaticResource PaddingSM}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,3,4,3" ColumnSpacing="{StaticResource Gap14}" MinHeight="42">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                            Background="{StaticResource AccentGradientBrush}"
                                                            VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                                    <Border Grid.Column="2" Width="{StaticResource CoverArtList}" Height="{StaticResource CoverArtList}"
                                                            CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource CoverPlaceholderBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconCoverPlaceholderSmall}"
                                                                      Foreground="{StaticResource PrimaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border CornerRadius="{StaticResource RadiusSM}">
                                                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ArtistsDisplay}" FontSize="{StaticResource FontSmall}"
                                                                   Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4" Text="{Binding DurationDisplay}" FontSize="{StaticResource FontSmall}"
                                                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <!-- Pagination -->
                                    <Border Padding="{StaticResource PaddingMD}" Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="0,0,12,12">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource GapMD}">
                                            <Button Content="&#xE76B; 上一页" Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding PreviousLibraryPageCommand}" IsEnabled="{Binding HasPreviousLibraryPage}" />
                                            <TextBlock Text="{Binding LibraryPaginationSummary}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSmall}" />
                                            <Button Content="下一页 &#xE76C;" Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding NextLibraryPageCommand}" IsEnabled="{Binding HasNextLibraryPage}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Favorites tab -->
                    <StackPanel x:Name="FavoritesTabContent" Visibility="Collapsed" Spacing="{StaticResource GapXL}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="我收藏的曲目" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}">
                                <ListView ItemsSource="{Binding FavoriteTracksView}" Style="{StaticResource TrackListStyle}"
                                          Padding="{StaticResource PaddingSM}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3,4,3" ColumnSpacing="{StaticResource Gap14}" MinHeight="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                        Background="{StaticResource AccentBrush}"
                                                        VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                                <Border Grid.Column="2" Width="{StaticResource CoverArtList}" Height="{StaticResource CoverArtList}"
                                                        CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource CoverPlaceholderBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconCoverPlaceholderSmall}"
                                                                  Foreground="{StaticResource PrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border CornerRadius="{StaticResource RadiusSM}">
                                                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ArtistsDisplay}" FontSize="{StaticResource FontSmall}"
                                                               Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding DurationDisplay}" FontSize="{StaticResource FontSmall}"
                                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Playlists tab -->
                    <StackPanel x:Name="PlaylistsTabContent" Visibility="Collapsed" Spacing="{StaticResource GapXL}">
                        <Grid ColumnSpacing="{StaticResource GapLG}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Playlist sidebar -->
                            <Grid>
                                <Border Style="{StaticResource CardShadowStyle}" />
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <StackPanel Padding="{StaticResource PaddingXL}" Spacing="{StaticResource GapMD}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="我的歌单" FontSize="{StaticResource FontSubtitleSM}" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBox Header="新建歌单" Text="{Binding NewPlaylistName, Mode=TwoWay}"
                                                 Style="{StaticResource AppTextBoxStyle}" />
                                        <Button Content="创建" Command="{Binding CreatePlaylistCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                                        <ListView ItemsSource="{Binding PlaylistsView}" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                                                  Style="{StaticResource TrackListStyle}" DisplayMemberPath="Name" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Playlist tracks -->
                            <Grid Grid.Column="1">
                                <Border Style="{StaticResource CardShadowStyle}" />
                                <Border Style="{StaticResource GlassCardStyle}">
                                    <StackPanel Spacing="{StaticResource GapMD}">
                                        <StackPanel Padding="{StaticResource PaddingXL}" Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="歌单曲目" FontSize="{StaticResource FontSubtitleSM}" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ListView ItemsSource="{Binding PlaylistTracksView}"
                                                  SelectedItem="{Binding SelectedPlaylistTrack, Mode=TwoWay}"
                                                  Style="{StaticResource TrackListStyle}" Padding="{StaticResource PaddingSM}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,3,4,3" ColumnSpacing="{StaticResource Gap14}" MinHeight="42">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                                Background="{StaticResource AccentGradientBrush}"
                                                                VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                                        <Border Grid.Column="2" Width="{StaticResource CoverArtList}" Height="{StaticResource CoverArtList}"
                                                            CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource CoverPlaceholderBrush}">
                                                            <Grid>
                                                                <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconCoverPlaceholderSmall}"
                                                                          Foreground="{StaticResource PrimaryBrush}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Border CornerRadius="{StaticResource RadiusSM}">
                                                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding Title}" FontSize="{StaticResource FontBody}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding DurationDisplay}" FontSize="{StaticResource FontSmall}"
                                                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- Profile tab -->
                    <StackPanel x:Name="ProfileTabContent" Visibility="Collapsed" Spacing="{StaticResource GapXL}">
                        <Grid>
                            <Border Style="{StaticResource CardShadowStyle}" />
                            <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource Padding3XL}">
                                <StackPanel Spacing="{StaticResource GapMD}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="用户资料" FontSize="{StaticResource FontSubtitleSM}" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding ProfileSummary}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding QueueBehaviorSummary}" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════════
                 SEARCH VIEW
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="SearchViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource GapXL}" Padding="4,0,12,32">
                    <!-- Search bar -->
                    <Grid>
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="搜索" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Width="300" PlaceholderText="搜索曲目、专辑、艺人..." Text="{Binding SearchKeyword, Mode=TwoWay}"
                                             Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Content="搜索" Command="{Binding OpenSearchCenterCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="清空最近" Command="{Binding ClearRecentSearchKeywordsCommand}"
                                            Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontCaption}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent keywords -->
                    <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}"
                            Visibility="{Binding HasRecentSearchKeywords, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="{StaticResource GapSM}">
                            <TextBlock Text="最近搜索" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <ItemsControl ItemsSource="{Binding RecentSearchKeywords}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding DataContext.ApplyRecentSearchKeywordCommand, ElementName=MainContentRoot}"
                                                CommandParameter="{Binding}" Margin="0,0,4,4" Padding="12,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Results -->
                    <Grid Visibility="{Binding HasPublicTracks, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}">
                            <ListView ItemsSource="{Binding PublicTracks}" SelectedItem="{Binding SelectedPublicTrack, Mode=TwoWay}"
                                      Style="{StaticResource TrackListStyle}" Padding="{StaticResource PaddingSM}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3,4,3" ColumnSpacing="{StaticResource Gap14}" MinHeight="42">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                    Background="{StaticResource AccentGradientBrush}"
                                                    VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                            <Border Grid.Column="2" Width="{StaticResource CoverArtList}" Height="{StaticResource CoverArtList}"
                                                    CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource CoverPlaceholderBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconCoverPlaceholderSmall}"
                                                              Foreground="{StaticResource PrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border CornerRadius="{StaticResource RadiusSM}">
                                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ArtistsDisplay}" FontSize="{StaticResource FontSmall}"
                                                           Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding DurationDisplay}" FontSize="{StaticResource FontSmall}"
                                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- No results message -->
                    <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource Padding4XL}"
                            Visibility="{Binding ShowSearchNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource GapMD}">
                            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconHeroSize}" Foreground="{StaticResource TextTertiaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="未找到匹配的曲目，请尝试其他关键词。"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontBody}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════════
                 ADMIN VIEW
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="AdminViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource GapXL}" Padding="4,0,12,32">
                    <!-- Admin sub-nav tabs -->
                    <Grid>
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingMD}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                    <Button Tag="users" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="users" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                            <TextBlock Text="用户" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="tags" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="tags" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                                            <TextBlock Text="标签" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="games" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="games" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                                            <TextBlock Text="游戏" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="artists" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
