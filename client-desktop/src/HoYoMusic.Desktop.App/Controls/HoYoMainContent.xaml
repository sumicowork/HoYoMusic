<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoMainContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Grid x:Name="MainContentRoot" RowSpacing="{StaticResource Gap10}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER: Section Title ═══ -->
        <Grid Grid.Row="0" Padding="4,4,4,0">
            <StackPanel>
                <TextBlock FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding CurrentSectionTitle}" />
                <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontCaption}"
                           Text="{Binding CurrentSectionSubtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Info & status bars -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource Gap2}" VerticalAlignment="Bottom" Margin="0,48,0,0">
            <InfoBar IsClosable="False" Severity="Error" Message="{Binding ErrorMessage}" IsOpen="{Binding HasErrorMessage}" />
            <InfoBar IsClosable="True" Severity="Success" Message="{Binding SuccessMessage}" IsOpen="{Binding ShowSuccessMessage}" CloseButtonClick="SuccessInfoBar_OnClose" />
            <ProgressBar IsIndeterminate="True" Height="2"
                         Visibility="{Binding ShowGlobalBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="0,6,0,0">

            <!-- Frame for page-based navigation -->
            <Frame x:Name="ContentFrame" Visibility="Visible" />

            <!-- ═══════════════════════════════════════════════════════════════
                 ADMIN VIEW
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="AdminViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource GapXL}" Padding="4,0,12,32">
                    <!-- Admin sub-nav tabs -->
                    <Grid>
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingMD}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                    <Button Tag="users" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="users" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                            <TextBlock Text="用户" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="tags" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="tags" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                                            <TextBlock Text="标签" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="games" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="games" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                                            <TextBlock Text="游戏" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="artists" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="artists" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                            <TextBlock Text="艺人" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="albums" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="albums" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE93C;" FontSize="14" />
                                            <TextBlock Text="专辑" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="music-sources" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="music-sources" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE8D4;" FontSize="14" />
                                            <TextBlock Text="来源库" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="analytics" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="analytics" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                                            <TextBlock Text="分析" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="settings" Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontBody}"
                                            Command="{Binding OpenAdminSectionCommand}" CommandParameter="settings" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                                            <TextBlock Text="设置" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Admin: Users -->
                    <Grid Visibility="{Binding IsAdminUsersSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{StaticResource PrimarySubtleBrush}" Margin="0,0,8,0">
                                        <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="用户管理" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="&#xE72C; 刷新" Command="{Binding RefreshAdminUsersCommand}" Style="{StaticResource GhostButtonStyle}" />
                                </Grid>
                                <TextBox Width="280" PlaceholderText="&#xE721; 搜索用户名或邮箱..." Text="{Binding AdminUserKeyword, Mode=TwoWay}"
                                         Style="{StaticResource AppTextBoxStyle}" HorizontalAlignment="Left" />
                                <ListView ItemsSource="{Binding AdminUsers}" SelectedItem="{Binding SelectedAdminUser, Mode=TwoWay}" Style="{StaticResource TrackListStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3,4,3" MinHeight="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                        Background="{StaticResource AccentGradientBrush}"
                                                        VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                                <Border Grid.Column="2" Width="36" Height="36" CornerRadius="{StaticResource RadiusFull}"
                                                        Background="{StaticResource CoverPlaceholderBrush}">
                                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Username}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Email}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextTertiaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="{StaticResource GapXS}" VerticalAlignment="Center">
                                                    <Button Content="角色" FontSize="{StaticResource FontSmall}" Style="{StaticResource GhostButtonStyle}"
                                                            Command="{Binding DataContext.ToggleAdminUserRoleCommand, ElementName=MainContentRoot}" CommandParameter="{Binding}" />
                                                    <Button Content="状态" FontSize="{StaticResource FontSmall}" Style="{StaticResource GhostButtonStyle}"
                                                            Command="{Binding DataContext.ToggleAdminUserStatusCommand, ElementName=MainContentRoot}" CommandParameter="{Binding}" />
                                                    <Button Content="密码" FontSize="{StaticResource FontSmall}" Style="{StaticResource GhostButtonStyle}"
                                                            Command="{Binding DataContext.ResetAdminUserPasswordCommand, ElementName=MainContentRoot}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Analytics -->
                    <Grid Visibility="{Binding IsAdminAnalyticsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{StaticResource AccentSubtleBrush}" Margin="0,0,8,0">
                                        <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="数据分析" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="&#xE72C; 刷新分析" Command="{Binding RefreshAdminAnalyticsCommand}" Style="{StaticResource GhostButtonStyle}" />
                                </Grid>
                                <TextBlock Text="{Binding AdminAnalyticsSummary}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ListView ItemsSource="{Binding AdminAnalyticsHourly}" Style="{StaticResource TrackListStyle}" MaxHeight="200">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Tags -->
                    <Grid Visibility="{Binding IsAdminTagsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{StaticResource PrimarySubtleBrush}" Margin="0,0,8,0">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="标签管理" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnSpacing="{StaticResource GapMD}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="标签名" Text="{Binding AdminTagName, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource GapSM}" VerticalAlignment="Bottom">
                                        <Button Content="&#xE710; 创建" Command="{Binding CreateAdminTagCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button Content="&#xE70F; 更新" Command="{Binding UpdateAdminTagCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="&#xE74D; 删除" Command="{Binding DeleteAdminTagCommand}" Style="{StaticResource GhostButtonStyle}" />
                                        <Button Content="&#xE72C;" Command="{Binding RefreshAdminTagsCommand}" Style="{StaticResource GhostButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <ListView ItemsSource="{Binding AdminTags}" SelectedItem="{Binding SelectedAdminTag, Mode=TwoWay}" Style="{StaticResource TrackListStyle}" MaxHeight="240" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Games -->
                    <Grid Visibility="{Binding IsAdminGamesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{StaticResource PrimarySubtleBrush}" Margin="0,0,8,0">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="游戏管理" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnSpacing="{StaticResource GapMD}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="游戏名" Text="{Binding AdminGameName, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource GapSM}" VerticalAlignment="Bottom">
                                        <Button Content="&#xE710; 创建" Command="{Binding CreateAdminGameCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button Content="&#xE70F; 更新" Command="{Binding UpdateAdminGameCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="&#xE72C;" Command="{Binding RefreshAdminGamesCommand}" Style="{StaticResource GhostButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedAdminGame, Mode=TwoWay}" Style="{StaticResource TrackListStyle}" MaxHeight="280">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2,4,2" MinHeight="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                        Background="{StaticResource AccentGradientBrush}"
                                                        VerticalAlignment="Stretch" Margin="0,6,0,6" />
                                                <Border Grid.Column="2" Width="32" Height="32" CornerRadius="{StaticResource RadiusMD}"
                                                        Background="{StaticResource CoverPlaceholderBrush}">
                                                    <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding DisplayName}" FontSize="{StaticResource FontBody}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Artists -->
                    <Grid Visibility="{Binding IsAdminArtistsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{StaticResource PrimarySubtleBrush}" Margin="0,0,8,0">
                                        <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="艺人管理" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="&#xE72C;" Command="{Binding RefreshAdminArtistsCommand}" Style="{StaticResource GhostButtonStyle}" />
                                </Grid>
                                <Grid ColumnSpacing="{StaticResource GapMD}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox PlaceholderText="&#xE721; 搜索艺人名称..." Text="{Binding AdminArtistSearchKeyword, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Grid.Column="1" Content="&#xE721; 搜索" Command="{Binding SearchAdminArtistsCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                </Grid>
                                <ListView ItemsSource="{Binding AdminArtists}" SelectedItem="{Binding SelectedAdminArtist, Mode=TwoWay}" Style="{StaticResource TrackListStyle}" MaxHeight="320">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3,4,3" MinHeight="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                        Background="{StaticResource AccentGradientBrush}"
                                                        VerticalAlignment="Stretch" Margin="0,8,0,8" />
                                                <Border Grid.Column="2" Width="40" Height="40" CornerRadius="{StaticResource RadiusFull}"
                                                        Background="{StaticResource CoverPlaceholderBrush}">
                                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding CanonicalName}" FontSize="{StaticResource FontSmall}"
                                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="4" Content="&#xE70F; 更新" FontSize="{StaticResource FontSmall}" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.UpdateAdminArtistCommand, ElementName=MainContentRoot}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Albums -->
                    <Grid Visibility="{Binding IsAdminAlbumsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{StaticResource PrimarySubtleBrush}" Margin="0,0,8,0">
                                        <FontIcon Glyph="&#xE93C;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="专辑管理" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="&#xE72C;" Command="{Binding RefreshTracksCommand}" Style="{StaticResource GhostButtonStyle}" />
                                </Grid>
                                <Grid ColumnSpacing="{StaticResource GapMD}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="专辑ID" Text="{Binding AdminAlbumIdText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Grid.Column="1" Content="&#xE8A5; 加载Disc" Command="{Binding LoadAdminDiscsCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                </Grid>
                                <InfoBar IsOpen="{Binding ShowAdminAlbumsStatus}" Severity="Informational" IsClosable="False" Message="{Binding AdminAlbumsStatusMessage}" />
                                <!-- Disc management -->
                                <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                                    <StackPanel Spacing="{StaticResource GapMD}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,4">
                                            <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusFull}"
                                                    Background="{StaticResource PrimarySubtleBrush}">
                                                <FontIcon Glyph="&#xE93C;" FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Disc 管理" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSubtitleSM}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                            <TextBox Header="Disc编号" Text="{Binding AdminDiscNumberText, Mode=TwoWay}" Width="80" Style="{StaticResource AppTextBoxStyle}" />
                                            <TextBox Header="Disc标题" Text="{Binding AdminDiscTitle, Mode=TwoWay}" Width="140" Style="{StaticResource AppTextBoxStyle}" />
                                            <Button Content="创建" Command="{Binding CreateAdminDiscCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                            <Button Content="更新" Command="{Binding UpdateAdminDiscCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                            <Button Content="删除" Command="{Binding DeleteAdminDiscCommand}" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <ListView ItemsSource="{Binding AdminDiscs}" SelectedItem="{Binding SelectedAdminDisc, Mode=TwoWay}" Style="{StaticResource TrackListStyle}" MaxHeight="160">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextPrimaryBrush}">
                                                            <Run Text="Disc #" /><Run Text="{Binding DiscNumber}" /><Run Text=" — " /><Run Text="{Binding DiscTitle}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                                <!-- Track binding -->
                                <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                                    <StackPanel Spacing="{StaticResource GapMD}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,4">
                                            <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusFull}"
                                                    Background="{StaticResource AccentSubtleBrush}">
                                                <FontIcon Glyph="&#xE71C;" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="曲目绑定 Disc" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSubtitleSM}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                            <TextBox Header="曲目ID" Text="{Binding AdminDiscTrackIdText, Mode=TwoWay}" Width="100" Style="{StaticResource AppTextBoxStyle}" />
                                            <Button Content="绑定到选中Disc" Command="{Binding AssignTrackToAdminDiscCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Settings (site config) -->
                    <StackPanel Spacing="{StaticResource GapXL}"
                                Visibility="{Binding IsAdminSettingsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                    Background="{StaticResource PrimarySubtleBrush}" Margin="0,0,8,0">
                                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="站点设置" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Button Content="&#xE72C; 刷新配置" Command="{Binding RefreshAdminSettingsCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Padding="14,8" />
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="维护模式" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Header="启用维护" IsOn="{Binding AdminMaintenanceEnabled, Mode=TwoWay}" />
                                <TextBox Header="维护消息" Text="{Binding AdminMaintenanceMessage, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <TextBox Header="预计结束时间(ISO)" Text="{Binding AdminMaintenanceExpectedEndTime, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <Button Content="保存维护配置" Command="{Binding SaveAdminMaintenanceConfigCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE9CE;" FontSize="10" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="首次访问弹窗" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Header="启用首次访问" IsOn="{Binding AdminFirstVisitEnabled, Mode=TwoWay}" />
                                <TextBox Header="标题" Text="{Binding AdminFirstVisitTitle, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <TextBox Header="内容" Text="{Binding AdminFirstVisitContent, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Style="{StaticResource AppTextBoxStyle}" />
                                <Button Content="保存首次访问配置" Command="{Binding SaveAdminFirstVisitConfigCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource PrimarySubtleBrush}">
                                        <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="备案配置" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Header="启用备案" IsOn="{Binding AdminComplianceEnabled, Mode=TwoWay}" />
                                <TextBox Header="ICP号" Text="{Binding AdminComplianceIcpNumber, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <TextBox Header="公安备案号" Text="{Binding AdminCompliancePublicSecurityNumber, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <Button Content="保存备案配置" Command="{Binding SaveAdminComplianceConfigCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource PrimarySubtleBrush}">
                                        <FontIcon Glyph="&#xE715;" FontSize="10" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="测试邮件" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Header="邮箱" Text="{Binding AdminTestEmail, Mode=TwoWay}" Width="220" Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Content="发送测试邮件" Command="{Binding SendAdminTestEmailCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE715;" FontSize="10" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="管理员发信" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Header="标题" Text="{Binding AdminMessageTitle, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <TextBox Header="内容" Text="{Binding AdminMessageContent, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Style="{StaticResource AppTextBoxStyle}" />
                                <ToggleSwitch Header="全站广播" IsOn="{Binding AdminMessageIsBroadcast, Mode=TwoWay}" />
                                <TextBox Header="接收用户ID（逗号分隔，非广播时必填）" Text="{Binding AdminMessageRecipientIdsText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <Button Content="发送站内信" Command="{Binding SendAdminMessageCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Admin: Track Tags Manager -->
                    <Grid Visibility="{Binding IsAdminMusicSourcesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource PrimarySubtleBrush}">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="曲目标签管理" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Header="曲目ID" Text="{Binding AdminTrackTagsTrackIdText, Mode=TwoWay}" Width="100" Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Content="加载标签" Command="{Binding LoadTrackTagsCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Header="添加标签ID" Text="{Binding AdminTrackTagsAddIdText, Mode=TwoWay}" Width="100" Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Content="添加标签" Command="{Binding AddTrackTagCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <InfoBar IsOpen="{Binding ShowAdminTrackTagsStatus}" Severity="Informational" IsClosable="False" Message="{Binding AdminTrackTagsStatusMessage}" />
                                <ListView ItemsSource="{Binding AdminTrackTags}" Style="{StaticResource TrackListStyle}" MaxHeight="240">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="移除" FontSize="{StaticResource FontSmall}" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.RemoveTrackTagCommand, ElementName=MainContentRoot}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Track Upload -->
                    <Grid Visibility="{Binding IsAdminMusicSourcesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE898;" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="曲目上传" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Header="音频文件路径（每行一条，支持换行/逗号/分号分隔）" Text="{Binding AdminTrackUploadPathsText, Mode=TwoWay}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" Style="{StaticResource AppTextBoxStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Header="专辑ID（可选）" Text="{Binding AdminTrackUploadAlbumIdText, Mode=TwoWay}" Width="100" Style="{StaticResource AppTextBoxStyle}" />
                                    <ToggleSwitch Header="自动解析Credits" IsOn="{Binding AdminTrackUploadAutoCredits, Mode=TwoWay}" />
                                    <Button Content="预览 Credits" Command="{Binding PreviewTrackCreditsCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                    <Button Content="上传曲目" Command="{Binding UploadTrackCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding AdminTrackUploadSummary}" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ListView ItemsSource="{Binding AdminTrackCreditPreview}" Style="{StaticResource TrackListStyle}" MaxHeight="180">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Margin="0,0,0,4" Padding="{StaticResource SpaceSM}">
                                                <StackPanel Spacing="{StaticResource GapXS}">
                                                    <TextBlock Text="{Binding FileName}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <ItemsControl ItemsSource="{Binding Credits}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                                                    <TextBlock Text="{Binding Key}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextTertiaryBrush}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Credits Viewer -->
                    <Grid Visibility="{Binding IsAdminMusicSourcesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource PrimarySubtleBrush}">
                                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Credits 查看" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Header="曲目ID" Text="{Binding AdminCreditsViewTrackIdText, Mode=TwoWay}" Width="100" Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Content="加载 Credits" Command="{Binding LoadCreditsForViewCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                    <Button Content="清空" Command="{Binding ClearCreditsViewCommand}" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <ListView ItemsSource="{Binding AdminCreditsViewItems}" Style="{StaticResource TrackListStyle}" MaxHeight="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                                    <TextBlock Text="{Binding CreditKey}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding CreditValue}" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Lyrics Import -->
                    <Grid Visibility="{Binding IsAdminMusicSourcesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="歌词导入" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Header="歌词文件路径（每行一条，支持换行/逗号/分号分隔）" Text="{Binding AdminLyricsImportPathsText, Mode=TwoWay}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Style="{StaticResource AppTextBoxStyle}" />
                                <TextBox Header="歧义消解（格式: 文件名=曲目ID，每行一条）" Text="{Binding AdminLyricsResolutionsText, Mode=TwoWay}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" Style="{StaticResource AppTextBoxStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <Button Content="预览导入" Command="{Binding PreviewAdminLyricsImportCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="提交导入" Command="{Binding CommitAdminLyricsImportCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AdminLyricsPreviewSummary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding AdminLyricsCommitSummary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                <ListView ItemsSource="{Binding AdminLyricsPreviewItems}" Style="{StaticResource TrackListStyle}" MaxHeight="160">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Admin: Import/Export -->
                    <StackPanel Spacing="{StaticResource GapXL}"
                                Visibility="{Binding IsAdminMusicSourcesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                    Background="{StaticResource PrimarySubtleBrush}" Margin="0,0,8,0">
                                <FontIcon Glyph="&#xE8B6;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="数据导入导出" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource PrimarySubtleBrush}">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="10" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="导出 Credits" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Header="专辑ID（逗号分隔）" Text="{Binding AdminExportCreditsAlbumIdsText, Mode=TwoWay}" Width="220" Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Content="导出 Credits" Command="{Binding ExportCreditsCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding AdminExportCreditsSummary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource PrimarySubtleBrush}">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="10" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="导出 Track Notes" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="导出全部 Track Notes" Command="{Binding ExportTrackNotesCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE8B6;" FontSize="10" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="导入 Track Notes" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Header="JSON 数据（entries 数组）" Text="{Binding AdminImportNotesJson, Mode=TwoWay}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Style="{StaticResource AppTextBoxStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <ComboBox Header="冲突策略" SelectedItem="{Binding AdminImportNotesConflictMode, Mode=TwoWay}" Width="120" Style="{StaticResource AppComboBoxStyle}">
                                        <x:String>append</x:String><x:String>overwrite</x:String><x:String>skip</x:String>
                                    </ComboBox>
                                    <Button Content="预览" Command="{Binding PreviewTrackNotesImportCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                    <Button Content="提交" Command="{Binding CommitTrackNotesImportCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding AdminImportNotesPreviewSummary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding AdminImportNotesCommitSummary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE8B6;" FontSize="10" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="导入 Catalog Metadata" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Header="JSON 数据（payload 对象）" Text="{Binding AdminImportMetadataJson, Mode=TwoWay}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Style="{StaticResource AppTextBoxStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <Button Content="预览" Command="{Binding PreviewCatalogMetadataImportCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="提交" Command="{Binding CommitCatalogMetadataImportCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AdminImportMetadataPreviewSummary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding AdminImportMetadataCommitSummary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <StackPanel Spacing="{StaticResource GapSM}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" Margin="0,0,0,2">
                                    <Border Width="20" Height="20" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="10" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="回滚 Catalog Metadata" FontWeight="SemiBold" FontSize="{StaticResource FontSubtitleSM}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                    <TextBox Header="Batch UUID" Text="{Binding AdminImportMetadataRollbackUuid, Mode=TwoWay}" Width="280" Style="{StaticResource AppTextBoxStyle}" />
                                    <Button Content="回滚" Command="{Binding RollbackCatalogMetadataCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding AdminImportMetadataRollbackSummary}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
