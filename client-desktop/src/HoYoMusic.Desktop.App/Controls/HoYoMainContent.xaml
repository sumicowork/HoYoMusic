                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,6">
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding TimestampDisplay}" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Method}" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="热门路径 / 状态码" />
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Top Pages" />
                                                            <ListView ItemsSource="{Binding AdminAnalyticsPages}" Style="{StaticResource TrackListStyle}" MaxHeight="180">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="72" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Hits}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Status Codes" />
                                                            <ListView ItemsSource="{Binding AdminAnalyticsStatusCodes}" Style="{StaticResource TrackListStyle}">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="72" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                                                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Value}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>

                                        <Grid Visibility="{Binding IsAdminGamesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="刷新游戏列表" Command="{Binding RefreshAdminGamesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button Content="前往游戏分区" Command="{Binding OpenSectionCommand}" CommandParameter="games" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding AdminGamesStatusMessage}" />
                                                </StackPanel>
                                                <Grid Grid.Row="1" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="游戏列表" />
                                                            <ProgressRing IsActive="{Binding IsAdminGamesLoading}" />
                                                            <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedAdminGame, Mode=TwoWay}" Style="{StaticResource TrackListStyle}">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,6">
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding StatusDisplay}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="游戏编辑器" />
                                                            <TextBox Header="名称" Text="{Binding AdminGameName, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            <TextBox Header="英文名" Text="{Binding AdminGameNameEn, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            <TextBox Header="描述" Text="{Binding AdminGameDescription, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="88" Style="{StaticResource AppTextBoxStyle}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBox Width="140" Header="排序" Text="{Binding AdminGameDisplayOrderText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                                <TextBox Width="160" Header="状态(active/maintenance/unreleased)" Text="{Binding AdminGameStatus, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            </StackPanel>
                                                            <TextBox Header="封面本地路径" Text="{Binding AdminGameCoverLocalPath, Mode=TwoWay}" PlaceholderText="例如 C:\\covers\\game.png" Style="{StaticResource AppTextBoxStyle}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button Content="上传选中封面" Command="{Binding UploadAdminGameCoverCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding SelectedAdminGame.CoverPath}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button Content="新建" Command="{Binding CreateAdminGameCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                                <Button Content="更新选中" Command="{Binding UpdateAdminGameCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                                <Button Content="清空" Command="{Binding ClearAdminGameFormCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>

                                        <Grid Visibility="{Binding IsAdminArtistsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBox Width="220" Header="搜索艺人" Text="{Binding AdminArtistSearchKeyword, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    <Button Content="搜索" Command="{Binding SearchAdminArtistsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button Content="刷新" Command="{Binding RefreshAdminArtistsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button Content="上一页" Command="{Binding PreviousAdminArtistsPageCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding HasPreviousAdminArtistsPage}" />
                                                    <Button Content="下一页" Command="{Binding NextAdminArtistsPageCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding HasNextAdminArtistsPage}" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding AdminArtistsPaginationSummary}" />
                                                    <Button Content="前往艺人分区" Command="{Binding OpenSectionCommand}" CommandParameter="artists" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding AdminArtistsStatusMessage}" />
                                                </StackPanel>
                                                <Grid Grid.Row="1" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SubtleGlassCardStyle}" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="艺人列表" />
                                                            <ProgressRing IsActive="{Binding IsAdminArtistsLoading}" />
                                                            <ListView ItemsSource="{Binding AdminArtists}" SelectedItem="{Binding SelectedAdminArtist, Mode=TwoWay}" Style="{StaticResource TrackListStyle}">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,6">
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding RolesDisplay}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource SubtleGlassCardStyle}" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="艺人别名" />
                                                            <ListView ItemsSource="{Binding AdminArtistAliases}" SelectedItem="{Binding SelectedAdminArtistAlias, Mode=TwoWay}" Style="{StaticResource TrackListStyle}">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource SubtleGlassCardStyle}" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="角色别名" />
                                                            <ListView ItemsSource="{Binding AdminArtistRoleAliases}" SelectedItem="{Binding SelectedAdminArtistRoleAlias, Mode=TwoWay}" Style="{StaticResource TrackListStyle}">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Margin="0,0,0,6" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Border Grid.Row="2" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="艺人操作" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBox Width="220" Header="艺人名称" Text="{Binding AdminArtistEditName, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            <TextBox Width="360" Header="角色映射(from=to，每行一条)" Text="{Binding AdminArtistRoleMappingsText, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="84" Style="{StaticResource AppTextBoxStyle}" />
                                                            <Button Content="更新艺人" Command="{Binding UpdateAdminArtistCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBox Width="420" Header="头像本地路径" Text="{Binding AdminArtistAvatarLocalPath, Mode=TwoWay}" PlaceholderText="例如 C:\\avatars\\artist.jpg" Style="{StaticResource AppTextBoxStyle}" />
                                                            <Button Content="上传选中艺人头像" Command="{Binding UploadAdminArtistAvatarCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding AdminArtistCurrentAvatarPath}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBox Width="220" Header="主名称" Text="{Binding AdminArtistCanonicalName, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            <TextBox Width="320" Header="别名列表(换行/逗号/分号)" Text="{Binding AdminArtistAliasNamesText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            <Button Content="合并别名" Command="{Binding MergeAdminArtistsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                            <Button Content="删除选中别名" Command="{Binding DeleteAdminArtistAliasCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBox Width="220" Header="主角色" Text="{Binding AdminArtistCanonicalRole, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            <TextBox Width="320" Header="角色别名列表" Text="{Binding AdminArtistAliasRolesText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            <Button Content="合并角色别名" Command="{Binding MergeAdminArtistRolesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                            <Button Content="删除选中角色别名" Command="{Binding DeleteAdminArtistRoleAliasCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Grid Visibility="{Binding IsAdminAlbumsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBox Width="180" Header="专辑ID" Text="{Binding AdminAlbumIdText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    <Button Content="加载 Disc" Command="{Binding LoadAdminDiscsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button Content="前往专辑分区" Command="{Binding OpenSectionCommand}" CommandParameter="albums" Style="{StaticResource SecondaryButtonStyle}" />
                                                </StackPanel>
                                                <InfoBar Grid.Row="1" IsOpen="{Binding ShowAdminAlbumsStatus}" Severity="Informational" IsClosable="False" Message="{Binding AdminAlbumsStatusMessage}" />
                                                <Grid Grid.Row="2" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="Disc 列表" />
                                                            <ListView ItemsSource="{Binding AdminDiscs}" SelectedItem="{Binding SelectedAdminDisc, Mode=TwoWay}" Style="{StaticResource TrackListStyle}">
                                                                <ListView.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,6">
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DiscNumber}" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DiscTitle}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ListView.ItemTemplate>
                                                            </ListView>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="Disc 编辑" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBox Width="120" Header="Disc 编号" Text="{Binding AdminDiscNumberText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                                <TextBox Width="220" Header="Disc 标题" Text="{Binding AdminDiscTitle, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button Content="新建" Command="{Binding CreateAdminDiscCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                                <Button Content="更新" Command="{Binding UpdateAdminDiscCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                                <Button Content="删除" Command="{Binding DeleteAdminDiscCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                                <Button Content="清空" Command="{Binding ClearAdminDiscFormCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBox Width="160" Header="曲目ID" Text="{Binding AdminDiscTrackIdText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                                <Button Content="绑定到选中 Disc" Command="{Binding AssignTrackToAdminDiscCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>

                                        <Grid Visibility="{Binding IsAdminMusicSourcesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="歌词批量导入" />
                                                    <TextBox Header="文件路径（支持换行/逗号/分号）"
                                                             Text="{Binding AdminLyricsImportPathsText, Mode=TwoWay}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"
                                                             MinHeight="96"
                                                             Style="{StaticResource AppTextBoxStyle}" />
                                                    <TextBox Header="冲突映射（每行 file_key=track_id，可选）"
                                                             Text="{Binding AdminLyricsResolutionsText, Mode=TwoWay}"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"
                                                             MinHeight="72"
                                                             Style="{StaticResource AppTextBoxStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="预览导入" Command="{Binding PreviewAdminLyricsImportCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                        <Button Content="提交导入" Command="{Binding CommitAdminLyricsImportCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AdminLyricsPreviewSummary}" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AdminLyricsCommitSummary}" TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Visibility="{Binding IsAdminSettingsSection, Converter={StaticResource BoolToVisibilityConverter}}" RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="刷新配置" Command="{Binding RefreshAdminSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="保存维护配置" Command="{Binding SaveAdminMaintenanceConfigCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Content="保存首次访问" Command="{Binding SaveAdminFirstVisitConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="保存备案配置" Command="{Binding SaveAdminComplianceConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                            <Border Grid.Row="1" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <ToggleSwitch Header="维护模式" IsOn="{Binding AdminMaintenanceEnabled, Mode=TwoWay}" />
                                                    <TextBox Header="维护提示" Text="{Binding AdminMaintenanceMessage, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    <TextBox Header="预计结束时间(文本)" Text="{Binding AdminMaintenanceExpectedEndTime, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="2" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBox Width="280" PlaceholderText="管理员测试邮箱" Text="{Binding AdminTestEmail, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    <Button Content="发送测试邮件" Command="{Binding SendAdminTestEmailCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Grid.Row="3" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="首次访问弹窗" />
                                                        <ToggleSwitch Header="启用弹窗" IsOn="{Binding AdminFirstVisitEnabled, Mode=TwoWay}" />
                                                        <TextBox Header="标题" Text="{Binding AdminFirstVisitTitle, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                        <TextBox Header="内容" Text="{Binding AdminFirstVisitContent, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Style="{StaticResource AppTextBoxStyle}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBox Width="150" Header="最短停留秒数" Text="{Binding AdminFirstVisitMinStaySecondsText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                            <TextBox Width="220" Header="版本" Text="{Binding AdminFirstVisitVersion, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="备案信息" />
                                                        <ToggleSwitch Header="显示备案栏" IsOn="{Binding AdminComplianceEnabled, Mode=TwoWay}" />
                                                        <TextBox Header="ICP备案号" Text="{Binding AdminComplianceIcpNumber, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                        <TextBox Header="公安备案号" Text="{Binding AdminCompliancePublicSecurityNumber, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <InfoBar Grid.Row="4" IsOpen="{Binding ShowAdminSettingsStatus}" Severity="Informational" IsClosable="False" Message="{Binding AdminSettingsStatusMessage}" />
                                            <Border Grid.Row="5" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="管理员站内信" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <ToggleSwitch Header="广播消息" IsOn="{Binding AdminMessageIsBroadcast, Mode=TwoWay}" />
                                                        <TextBox Width="280" Header="接收用户ID（逗号分隔）" Text="{Binding AdminMessageRecipientIdsText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                        <TextBox Width="240" Header="过期时间（可选）" Text="{Binding AdminMessageExpiresAtText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="加入当前选中用户" Command="{Binding AddSelectedAdminUserToMessageRecipientsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                        <Button Content="清空接收用户" Command="{Binding ClearAdminMessageRecipientsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    </StackPanel>
                                                    <TextBox Header="标题" Text="{Binding AdminMessageTitle, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                    <TextBox Header="内容" Text="{Binding AdminMessageContent, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" Style="{StaticResource AppTextBoxStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="发送站内信" Command="{Binding SendAdminMessageCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="6" Style="{StaticResource SubtleGlassCardStyle}" Padding="12">
                                                <Grid RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="反馈管理" />
                                                        <Button Content="刷新反馈" Command="{Binding RefreshAdminFeedbackCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    </StackPanel>
                                                    <ListView Grid.Row="1" ItemsSource="{Binding AdminFeedbackItems}" Style="{StaticResource TrackListStyle}">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,8" Padding="10">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Content}" TextWrapping="WrapWholeWords" />
                                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Contact}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                        <Button Content="上一页" Command="{Binding PreviousAdminFeedbackPageCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding HasPreviousAdminFeedbackPage}" />
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding AdminFeedbackPaginationSummary}" />
                                                        <Button Content="下一页" Command="{Binding NextAdminFeedbackPageCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding HasNextAdminFeedbackPage}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
</UserControl>
