<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoMainContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="MainContentRoot" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER: Title + 3-view nav ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding CurrentSectionTitle}" />
                <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                           Text="{Binding CurrentSectionSubtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- 3-tab nav -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"
                           Text="{Binding CurrentUserDisplay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="BrowseNavButton" Content="发现" Click="BrowseNav_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" />
                <Button x:Name="LibraryNavButton" Content="曲库" Click="LibraryNav_Click"
                        Style="{StaticResource GhostButtonStyle}" Padding="16,8" />
                <Button x:Name="SearchNavButton" Content="搜索" Click="SearchNav_Click"
                        Style="{StaticResource GhostButtonStyle}" Padding="16,8" />
                <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="更多" Margin="4,0,0,0">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="个人中心" Tag="profile" Click="MoreMenu_Click" />
                            <MenuFlyoutItem Text="下载中心" Tag="downloads" Click="MoreMenu_Click" />
                            <MenuFlyoutItem Text="用户设置" Tag="settings" Click="MoreMenu_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="管理后台" Tag="admin" Click="MoreMenu_Click"
                                            Visibility="{Binding ShowAdminEntry, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Info bars -->
        <InfoBar Grid.Row="1" IsClosable="False" Severity="Error" Message="{Binding ErrorMessage}" IsOpen="{Binding HasErrorMessage}" />
        <InfoBar Grid.Row="1" IsClosable="True" Severity="Success" Message="{Binding SuccessMessage}" IsOpen="{Binding ShowSuccessMessage}" CloseButtonClick="SuccessInfoBar_OnClose" />

        <!-- ═══ CONTENT ═══ -->
        <Grid Grid.Row="2" Margin="0,6,0,0">

            <!-- ═══════ BROWSE VIEW ═══════ -->
            <ScrollViewer x:Name="BrowseViewPanel" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Browse sub-nav -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="发现" Tag="discover" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                        <Button Content="游戏" Tag="games" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                        <Button Content="专辑" Tag="albums" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                        <Button Content="艺人" Tag="artists" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                        <Button Content="标签" Tag="tags" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                    </StackPanel>

                    <!-- DISCOVER -->
                    <StackPanel x:Name="DiscoverContent" Visibility="Visible" Spacing="16">
                        <!-- Game selector -->
                        <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                  Style="{StaticResource TrackListStyle}" MaxHeight="160">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Margin="0,0,0,4" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                                Background="{StaticResource PrimarySubtleColor}">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="{StaticResource PrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11"
                                                       Foreground="{StaticResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Album cards (horizontal) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="专辑" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ListView ItemsSource="{Binding SelectedGameAlbums}"
                                      SelectedItem="{Binding SelectedGameAlbum, Mode=TwoWay}"
                                      SelectionMode="Single" IsItemClickEnabled="True"
                                      ItemClick="DiscoverAlbumsList_OnItemClick"
                                      Style="{StaticResource TrackListStyle}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="170" Margin="0,0,12,0" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="170" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8"
                                                    Background="{StaticResource PrimarySubtleColor}">
                                                <FontIcon Glyph="&#xE8D4;" FontSize="32"
                                                          Foreground="{StaticResource PrimaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Tracks: Random + Top side by side -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="随机推荐" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <ListView ItemsSource="{Binding RandomTracksView}" Style="{StaticResource TrackListStyle}" MaxHeight="280">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AlbumTitle}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="热门曲目" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <ListView ItemsSource="{Binding TopTracksView}" Style="{StaticResource TrackListStyle}" MaxHeight="280">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AlbumTitle}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- GAMES -->
                    <StackPanel x:Name="GamesContent" Visibility="Collapsed" Spacing="8">
                        <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                  Style="{StaticResource TrackListStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Margin="0,0,0,6" MinHeight="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                                Background="{StaticResource PrimarySubtleColor}">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11"
                                                       Foreground="{StaticResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- ALBUMS / ARTISTS / TAGS — simplified -->
                    <StackPanel x:Name="AlbumsContent" Visibility="Collapsed" Spacing="8">
                        <ListView ItemsSource="{Binding SelectedGameAlbums}" Style="{StaticResource TrackListStyle}"
                                  IsItemClickEnabled="True" ItemClick="DiscoverAlbumsList_OnItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel x:Name="ArtistsContent" Visibility="Collapsed" Spacing="8">
                        <ListView ItemsSource="{Binding ArtistFacetItems}" Style="{StaticResource TrackListStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="TagsContent" Visibility="Collapsed" Spacing="8">
                        <ListView ItemsSource="{Binding TagFacetItems}" Style="{StaticResource TrackListStyle}" />
                    </StackPanel>

                    <!-- ALBUM DETAIL -->
                    <StackPanel x:Name="AlbumDetailContent" Visibility="Collapsed" Spacing="10">
                        <Button Content="← 返回" Tag="discover" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="8"
                                    Background="{StaticResource PrimarySubtleColor}">
                                <FontIcon Glyph="&#xE8D4;" FontSize="28" Foreground="{StaticResource PrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding CurrentAlbum.Title}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="WrapWholeWords" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           Text="浏览专辑曲目" />
                                <Button Content="播放全部" Command="{Binding PlayAlbumAllCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                        <ListView ItemsSource="{Binding AlbumTrackRows}" Style="{StaticResource TrackListStyle}"
                                  IsItemClickEnabled="True" ItemClick="AlbumTrackList_OnItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PlayingIndicator}" Width="20"
                                                   Foreground="{StaticResource PrimaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArtistsDisplay}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- TRACK DETAIL -->
                    <StackPanel x:Name="TrackDetailContent" Visibility="Collapsed" Spacing="10">
                        <Button Content="← 返回" Tag="discover" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding CurrentDetailTrack.Title}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{Binding CurrentDetailTrack.ArtistsDisplay}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />
                            <TextBlock Text="{Binding CurrentDetailTrack.AlbumTitle}"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" />
                            <TextBlock Text="{Binding CurrentDetailTrack.DurationDisplay}"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="播放" Command="{Binding PlayCurrentDetailTrackCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="收藏" Command="{Binding ToggleFavoriteForCurrentDetailTrackCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                            <Button Content="加到歌单" Command="{Binding AddCurrentDetailTrackToPlaylistCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                            <Button Content="下载" Command="{Binding DownloadCurrentDetailTrackCommand}"
                                    Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DetailLyricsPreview}" FontSize="14" LineHeight="22"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{Binding DetailCreditsSummary}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding DetailMusicSourcesSummary}"
                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════ LIBRARY VIEW ═══════ -->
            <ScrollViewer x:Name="LibraryViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- Library sub-tabs -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="曲库" Tag="library" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                        <Button Content="收藏" Tag="favorites" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                        <Button Content="歌单" Tag="playlists" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                        <Button Content="个人" Tag="profile" Click="SubNav_Click" Style="{StaticResource GhostButtonStyle}" FontSize="13" />
                    </StackPanel>

                    <!-- Library tab -->
                    <StackPanel x:Name="LibraryTabContent" Visibility="Visible" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Width="200" PlaceholderText="搜索" Text="{Binding SearchKeyword, Mode=TwoWay}"
                                     Style="{StaticResource AppTextBoxStyle}" />
                            <ComboBox Width="90" SelectedItem="{Binding DurationBucket, Mode=TwoWay}">
                                <x:String></x:String><x:String>short</x:String><x:String>medium</x:String><x:String>long</x:String>
                            </ComboBox>
                            <ComboBox Width="90" SelectedItem="{Binding LyricsStatus, Mode=TwoWay}">
                                <x:String></x:String><x:String>has_lyrics</x:String><x:String>instrumental</x:String><x:String>none</x:String>
                            </ComboBox>
                            <Button Content="搜索" Command="{Binding SearchPublicTracksCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="重置" Command="{Binding ResetLibraryFiltersCommand}"
                                    Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>
                        <ListView ItemsSource="{Binding PublicTracks}" SelectedItem="{Binding SelectedPublicTrack, Mode=TwoWay}"
                                  Style="{StaticResource TrackListStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArtistsDisplay}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <Button Content="上一页" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding PreviousLibraryPageCommand}" IsEnabled="{Binding HasPreviousLibraryPage}" />
                            <TextBlock Text="{Binding LibraryPaginationSummary}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" />
                            <Button Content="下一页" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding NextLibraryPageCommand}" IsEnabled="{Binding HasNextLibraryPage}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Favorites tab -->
                    <StackPanel x:Name="FavoritesTabContent" Visibility="Collapsed" Spacing="8">
                        <ListView ItemsSource="{Binding FavoriteTracksView}" Style="{StaticResource TrackListStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArtistsDisplay}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Playlists tab -->
                    <StackPanel x:Name="PlaylistsTabContent" Visibility="Collapsed" Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBox Header="新建歌单" Text="{Binding NewPlaylistName, Mode=TwoWay}"
                                         Style="{StaticResource AppTextBoxStyle}" />
                                <Button Content="创建" Command="{Binding CreatePlaylistCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <ListView ItemsSource="{Binding PlaylistsView}" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                                          Style="{StaticResource TrackListStyle}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <ListView Grid.Column="1" ItemsSource="{Binding PlaylistTracksView}"
                                      SelectedItem="{Binding SelectedPlaylistTrack, Mode=TwoWay}"
                                      Style="{StaticResource TrackListStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </StackPanel>

                    <!-- Profile tab -->
                    <StackPanel x:Name="ProfileTabContent" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="{Binding ProfileSummary}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding QueueBehaviorSummary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════ SEARCH VIEW ═══════ -->
            <ScrollViewer x:Name="SearchViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Width="280" PlaceholderText="搜索曲目、专辑、艺人..." Text="{Binding SearchKeyword, Mode=TwoWay}"
                                 Style="{StaticResource AppTextBoxStyle}" />
                        <Button Content="搜索" Command="{Binding OpenSearchCenterCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="清空最近" Command="{Binding ClearRecentSearchKeywordsCommand}"
                                Style="{StaticResource GhostButtonStyle}" FontSize="12" />
                    </StackPanel>
                    <!-- Recent keywords -->
                    <ItemsControl ItemsSource="{Binding RecentSearchKeywords}"
                                  Visibility="{Binding HasRecentSearchKeywords, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding DataContext.ApplyRecentSearchKeywordCommand, ElementName=MainContentRoot}"
                                        CommandParameter="{Binding}" Margin="0,0,4,4" Padding="8,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Results -->
                    <ListView ItemsSource="{Binding PublicTracks}" SelectedItem="{Binding SelectedPublicTrack, Mode=TwoWay}"
                              Style="{StaticResource TrackListStyle}"
                              Visibility="{Binding HasPublicTracks, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ArtistsDisplay}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════ ADMIN VIEW ═══════ -->
            <ScrollViewer x:Name="AdminViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="用户" Tag="users" Style="{StaticResource GhostButtonStyle}" FontSize="13"
                                Command="{Binding OpenAdminSectionCommand}" CommandParameter="users" />
                        <Button Content="标签" Tag="tags" Style="{StaticResource GhostButtonStyle}" FontSize="13"
                                Command="{Binding OpenAdminSectionCommand}" CommandParameter="tags" />
                        <Button Content="游戏" Tag="games" Style="{StaticResource GhostButtonStyle}" FontSize="13"
                                Command="{Binding OpenAdminSectionCommand}" CommandParameter="games" />
                        <Button Content="艺人" Tag="artists" Style="{StaticResource GhostButtonStyle}" FontSize="13"
                                Command="{Binding OpenAdminSectionCommand}" CommandParameter="artists" />
                        <Button Content="专辑" Tag="albums" Style="{StaticResource GhostButtonStyle}" FontSize="13"
                                Command="{Binding OpenAdminSectionCommand}" CommandParameter="albums" />
                        <Button Content="来源库" Tag="music-sources" Style="{StaticResource GhostButtonStyle}" FontSize="13"
                                Command="{Binding OpenAdminSectionCommand}" CommandParameter="music-sources" />
                        <Button Content="分析" Tag="analytics" Style="{StaticResource GhostButtonStyle}" FontSize="13"
                                Command="{Binding OpenAdminSectionCommand}" CommandParameter="analytics" />
                        <Button Content="设置" Tag="settings" Style="{StaticResource GhostButtonStyle}" FontSize="13"
                                Command="{Binding OpenAdminSectionCommand}" CommandParameter="settings" />
                    </StackPanel>
                    <!-- Admin sub-section content (dynamically shown based on SelectedAdminSection) -->
                    <Grid Visibility="{Binding IsAdminUsersSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="用户管理" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBox Width="200" PlaceholderText="搜索用户" Text="{Binding AdminUserKeyword, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <Button Content="刷新" Command="{Binding RefreshAdminUsersCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <ListView ItemsSource="{Binding AdminUsers}" SelectedItem="{Binding SelectedAdminUser, Mode=TwoWay}" Style="{StaticResource TrackListStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Username}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Button Content="切换角色" FontSize="11" Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.ToggleAdminUserRoleCommand, ElementName=MainContentRoot}" CommandParameter="{Binding}" />
                                                <Button Content="启用/禁用" FontSize="11" Style="{StaticResource GhostButtonStyle}"
