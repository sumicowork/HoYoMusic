                                    </Button>
                                    <Button Grid.Column="2" HorizontalAlignment="Stretch"
                                            Command="{Binding SetThemeModeCommand}" CommandParameter="system"
                                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,14">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F8;" FontSize="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="跟随系统" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Data Management ── -->
                    <Grid>
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource Padding2XL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                    <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{StaticResource PrimarySubtleBrush}">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="数据管理" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="重置所有本地设置为默认值（不影响服务端数据）"
                                           FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextTertiaryBrush}" />
                                <Button Content="&#xE74D; 重置所有设置" Command="{Binding ResetAllSettingsCommand}"
                                        Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Padding="14,8" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Feedback ── -->
                    <Grid>
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource Padding2XL}">
                            <StackPanel Spacing="{StaticResource GapMD}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                    <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                            Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xED15;" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="反馈与建议" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Header="联系方式（可选）" Text="{Binding FeedbackContact, Mode=TwoWay}"
                                         Style="{StaticResource AppTextBoxStyle}" />
                                <TextBox Header="反馈内容" Text="{Binding FeedbackContent, Mode=TwoWay}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Style="{StaticResource AppTextBoxStyle}" />
                                <Button Content="&#xE724; 提交反馈" Command="{Binding SubmitFeedbackCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="20,10" />
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════════
                 DOWNLOADS VIEW
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="DownloadsViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource Gap2XL}" Padding="4,0,12,32">
                    <!-- Hero header -->
                    <Border Style="{StaticResource HeroCardStyle}" MinHeight="80">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource GapSM}" VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource FontDisplay}" FontWeight="Bold"
                                           Foreground="{StaticResource TextInverseBrush}" Text="下载中心" />
                                <TextBlock FontSize="{StaticResource FontSubtitle}" Foreground="#CCFFFFFF"
                                           Text="管理你的下载任务" />
                            </StackPanel>
                            <FontIcon Grid.Column="1" Glyph="&#xE896;" FontSize="50" Foreground="#15FFFFFF"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                        </Grid>
                    </Border>

                    <!-- Toolbar -->
                    <Grid>
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingLG}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                                <Button Content="&#xE72C; 刷新" Command="{Binding RefreshDownloadCenterCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="&#xE711; 全部取消" Command="{Binding CancelAllDownloadsCommand}" Style="{StaticResource GhostButtonStyle}" />
                                <TextBox Width="200" PlaceholderText="&#xE721; 搜索任务..." Text="{Binding DownloadSearchText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <ComboBox Width="130" SelectedItem="{Binding DownloadStatusFilter, Mode=TwoWay}" Style="{StaticResource AppComboBoxStyle}">
                                    <x:String>全部</x:String><x:String>等待中</x:String><x:String>下载中</x:String><x:String>已完成</x:String><x:String>失败</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Download tasks -->
                    <ListView ItemsSource="{Binding DownloadTasks}" Style="{StaticResource TrackListStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Border Style="{StaticResource CardShadowStyle}" />
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                                        <Grid ColumnSpacing="{StaticResource GapMD}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                    Background="{StaticResource AccentGradientBrush}"
                                                    VerticalAlignment="Stretch" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontCaption}"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="8" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="{StaticResource GapXS}" VerticalAlignment="Center">
                                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSmall}" Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.CancelDownloadCommand, ElementName=MainContentRoot}" CommandParameter="{Binding Id}"
                                                        AutomationProperties.Name="取消下载" />
                                                <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSmall}" Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.RetryFailedDownloadCommand, ElementName=MainContentRoot}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="重试下载" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
