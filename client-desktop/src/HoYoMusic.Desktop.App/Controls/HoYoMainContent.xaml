<UserControl
    x:Class="HoYoMusic.Desktop.App.Controls.HoYoMainContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="MainContentRoot" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding CurrentSectionTitle}" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding CurrentSectionSubtitle}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding NowPlaying}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="14" Height="14" IsActive="{Binding IsBusy}" Visibility="{Binding ShowGlobalBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding CurrentUserDisplay}" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding LoadingStage}" />
                            </StackPanel>
                        </Grid>
                        <InfoBar Grid.Row="1" IsClosable="False" Severity="Error" Message="{Binding ErrorMessage}" IsOpen="{Binding HasErrorMessage}" />
                        <InfoBar Grid.Row="2" IsClosable="True" CloseButtonClick="SuccessInfoBar_OnClose" Severity="Success" Message="{Binding SuccessMessage}" IsOpen="{Binding ShowSuccessMessage}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="10">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DiscoverNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="discover" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE81E;" FontSize="16"/>
        <TextBlock Text="发现" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="GamesNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="games" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE7FC;" FontSize="16"/>
        <TextBlock Text="游戏" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="AlbumsNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="albums" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE142;" FontSize="16"/>
        <TextBlock Text="专辑" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="ArtistsNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="artists" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE77B;" FontSize="16"/>
        <TextBlock Text="艺人" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="TagsNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="tags" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xED35;" FontSize="16"/>
        <TextBlock Text="标签" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="SearchNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="search" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE11A;" FontSize="16"/>
        <TextBlock Text="搜索" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="LibraryNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="library" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE1D3;" FontSize="16"/>
        <TextBlock Text="曲库" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="FavoritesNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="favorites" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE00B;" FontSize="16"/>
        <TextBlock Text="收藏" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="PlaylistsNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="playlists" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE142;" FontSize="16"/>
        <TextBlock Text="歌单" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="ProfileNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="profile" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE77B;" FontSize="16"/>
        <TextBlock Text="个人" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="SettingsNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="settings" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE713;" FontSize="16"/>
        <TextBlock Text="设置" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="DownloadsNavButton" Command="{Binding OpenSectionCommand}" CommandParameter="downloads" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" CornerRadius="8" Padding="12,8">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE896;" FontSize="16"/>
        <TextBlock Text="下载" VerticalAlignment="Center"/>
    </StackPanel>
</Button>
                                <Button x:Name="AdminNavButton" Content="管理" Command="{Binding OpenSectionCommand}" CommandParameter="admin" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <Grid x:Name="DiscoverSectionPanel" Visibility="Visible">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource GlassCardStyle}" Background="{StaticResource GlassStrongBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Text="发现" />
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding SelectedGameSummary}" />
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DiscoverSummary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <ProgressRing Width="14" Height="14" IsActive="{Binding IsBusy}" Visibility="{Binding IsDiscoverLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Content="刷新" Command="{Binding RefreshDiscoverCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBox Width="160" PlaceholderText="筛选发现曲目" Text="{Binding DiscoverFilterText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                <ComboBox Width="92" SelectedItem="{Binding DiscoverRandomCount, Mode=TwoWay}">
                                                    <x:Int32>5</x:Int32>
                                                    <x:Int32>10</x:Int32>
                                                    <x:Int32>15</x:Int32>
                                                    <x:Int32>20</x:Int32>
                                                    <x:Int32>30</x:Int32>
                                                </ComboBox>
                                                <Button Content="刷新随机" Command="{Binding RefreshRandomTracksCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <ComboBox Width="92" SelectedItem="{Binding DiscoverTopCount, Mode=TwoWay}">
                                                    <x:Int32>5</x:Int32>
                                                    <x:Int32>10</x:Int32>
                                                    <x:Int32>20</x:Int32>
                                                    <x:Int32>50</x:Int32>
                                                    <x:Int32>100</x:Int32>
                                                </ComboBox>
                                                <Button Content="刷新热门" Command="{Binding RefreshTopTracksCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="播放筛选" Command="{Binding PlayFilteredDiscoverTracksCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="播放当前游戏" Command="{Binding PlaySelectedGameAllCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <InfoBar Grid.Row="0" IsOpen="{Binding ShowDiscoverStatus}" Severity="Informational" IsClosable="False" Message="{Binding DiscoverStatusMessage}" />

                                            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Background="{StaticResource GlassStrongBrush}" Padding="14">
                                                <Grid RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Text="推荐专辑" />
                                                        <Button Grid.Column="1" Content="播放选中专辑" Command="{Binding QuickPlayAlbumCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                    <Border Grid.Row="1" Style="{StaticResource SubtleGlassCardStyle}" Padding="12" Visibility="{Binding HasRecommendedAlbums, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="该游戏暂时没有推荐专辑" />
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="可尝试切换到其他游戏，或稍后刷新。" TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ListView Grid.Row="1" Style="{StaticResource TrackListStyle}" ItemsSource="{Binding SelectedGameAlbums}" SelectedItem="{Binding SelectedGameAlbum, Mode=TwoWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="DiscoverAlbumsList_OnItemClick" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Visibility="{Binding HasRecommendedAlbums, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ListView.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <ItemsStackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ListView.ItemsPanel>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Width="220" Margin="0,0,14,0" RowSpacing="8">
                                                                    <Grid RenderTransformOrigin="0.5,0.5" PointerEntered="AlbumCard_OnPointerEntered" PointerExited="AlbumCard_OnPointerExited">
                                                                        <Grid.RenderTransform>
                                                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                        </Grid.RenderTransform>
                                                                        <Button Command="{Binding DataContext.OpenAlbumDetailCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0">
                                                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Width="220" Height="248" Padding="8">
                                                                                <Grid RowSpacing="8">
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="*" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                    </Grid.RowDefinitions>
                                                                                    <Border CornerRadius="10" Background="#FFEAF1FF">
                                                                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                                                    </Border>
                                                                                    <TextBlock Grid.Row="1" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="WrapWholeWords" MaxLines="2" />
                                                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="曲目" />
                                                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding TrackCount}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Button>
                                                                        <Border x:Name="AlbumPlayOverlay" Opacity="0" Width="220" Height="248" CornerRadius="14" Background="#2F000000" IsHitTestVisible="False">
                                                                            <Grid>
                                                                                <Border Width="48" Height="48" CornerRadius="24" Background="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="#FF2F3B57" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>
                                                                    <Button Grid.Row="1" Content="立即播放" Command="{Binding DataContext.QuickPlayAlbumCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="2" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="12">
                                                    <Grid RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="随机推荐曲目" />
                                                        <Border Grid.Row="1" Style="{StaticResource SubtleGlassCardStyle}" Padding="12" Visibility="{Binding HasRandomTracks, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                                            <StackPanel Spacing="6">
                                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="当前没有可展示的随机曲目" />
                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="可点击“刷新随机”或切换左侧游戏图标后再试。" TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ListView Grid.Row="1" Style="{StaticResource TrackListStyle}" ItemsSource="{Binding RandomTracksView}" Visibility="{Binding HasRandomTracks, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AlbumTitle}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="▶" Command="{Binding DataContext.PlayRandomTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource CircleActionButtonStyle}" Width="32" Height="32" Padding="0"/>
<Button Grid.Column="2" FontFamily="Segoe MDL2 Assets" Content="&#xE712;" Style="{StaticResource SecondaryButtonStyle}" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
    <Button.Flyout>
        <MenuFlyout>
            <MenuFlyoutItem Text="详情" Command="{Binding DataContext.OpenDiscoverTrackDetailCommand, ElementName=RootGrid}" CommandParameter="{Binding}"/>
            <MenuFlyoutItem Text="收藏" Command="{Binding DataContext.ToggleFavoriteForDiscoverTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" IsEnabled="{Binding DataContext.IsAuthenticated, ElementName=RootGrid}"/>
            <MenuFlyoutItem Text="加到队列" Command="{Binding DataContext.EnqueueDiscoverTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}"/>
            <MenuFlyoutItem Text="下一首播放" Command="{Binding DataContext.PlayDiscoverTrackNextCommand, ElementName=RootGrid}" CommandParameter="{Binding}"/>
        </MenuFlyout>
    </Button.Flyout>
</Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="12">
                                                    <Grid RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="热门曲目" />
                                                        <Border Grid.Row="1" Style="{StaticResource SubtleGlassCardStyle}" Padding="12" Visibility="{Binding HasTopTracks, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                                            <StackPanel Spacing="6">
                                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="当前没有可展示的热门曲目" />
                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="可点击“刷新热门”获取当前游戏的热门结果。" TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ListView Grid.Row="1" Style="{StaticResource TrackListStyle}" ItemsSource="{Binding TopTracksView}" Visibility="{Binding HasTopTracks, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding PlayCount}" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="▶" Command="{Binding DataContext.PlayTopTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource CircleActionButtonStyle}" Width="32" Height="32" Padding="0"/>
<Button Grid.Column="2" FontFamily="Segoe MDL2 Assets" Content="&#xE712;" Style="{StaticResource SecondaryButtonStyle}" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
    <Button.Flyout>
        <MenuFlyout>
            <MenuFlyoutItem Text="详情" Command="{Binding DataContext.OpenDiscoverTrackDetailCommand, ElementName=RootGrid}" CommandParameter="{Binding}"/>
            <MenuFlyoutItem Text="收藏" Command="{Binding DataContext.ToggleFavoriteForDiscoverTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" IsEnabled="{Binding DataContext.IsAuthenticated, ElementName=RootGrid}"/>
            <MenuFlyoutItem Text="加到队列" Command="{Binding DataContext.EnqueueDiscoverTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}"/>
            <MenuFlyoutItem Text="下一首播放" Command="{Binding DataContext.PlayDiscoverTrackNextCommand, ElementName=RootGrid}" CommandParameter="{Binding}"/>
        </MenuFlyout>
    </Button.Flyout>
</Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <Grid x:Name="AlbumDetailSectionPanel" Visibility="Collapsed">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="← 返回发现" Command="{Binding BackToDiscoverCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="播放专辑" Command="{Binding PlayAlbumAllCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button Content="收藏当前曲目" Command="{Binding ToggleFavoriteCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                                        <Button Content="添加到歌单" Command="{Binding AddAlbumTrackToPlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Background="{StaticResource GlassStrongBrush}" Padding="14">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <InfoBar Grid.Row="0" IsOpen="{Binding ShowAlbumStatus}" Severity="Informational" IsClosable="False" Message="{Binding AlbumStatusMessage}" />
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" Text="{Binding CurrentAlbum.Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding CurrentAlbum.Notes}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                            </StackPanel>
                                            <ListView Grid.Row="2" Style="{StaticResource TrackListStyle}" ItemsSource="{Binding AlbumTrackRows}" SelectedItem="{Binding SelectedAlbumTrackRow, Mode=TwoWay}" IsItemClickEnabled="True" ItemClick="AlbumTrackList_OnItemClick">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource SubtleGlassCardStyle}" Margin="0,0,0,8" Padding="10">
                                                            <Grid ColumnSpacing="10" Height="56">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding PlayingIndicator}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ArtistsDisplay}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Content="▶" Command="{Binding DataContext.PlayAlbumTrackRowCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource CircleActionButtonStyle}" Width="32" Height="32" Padding="0"/>
<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding DurationDisplay}" Margin="0,0,8,0" />
    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE712;" Style="{StaticResource SecondaryButtonStyle}" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
        <Button.Flyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="详情" Command="{Binding DataContext.OpenAlbumTrackDetailCommand, ElementName=RootGrid}" CommandParameter="{Binding}"/>
            </MenuFlyout>
        </Button.Flyout>
    </Button>
</StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid x:Name="GamesSectionPanel" Visibility="Collapsed">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="前端对齐：游戏列表与游戏详情入口。" />
                                    <ListView Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" Style="{StaticResource TrackListStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,8" Padding="10">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding StatusDisplay}" />
                                                        </StackPanel>
