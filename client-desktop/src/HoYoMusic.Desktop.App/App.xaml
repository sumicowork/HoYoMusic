<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HoYoMusic.Desktop.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:HoYoMusic.Desktop.App.Converters"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- ═══════════════════════════════════════════
                 BRUSHES — Layered color system for depth & glass
                 ═══════════════════════════════════════════ -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF6366F1" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF5558E6" />
            <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#FFEEF0FF" />
            <SolidColorBrush x:Key="PrimaryDeepBrush" Color="#FF4F46E5" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FFF59E42" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FFFEECD0" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFBFBFE" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF5F5FA" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF18181B" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF52525B" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF71717A" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF22C55E" />
            <SolidColorBrush x:Key="SpectrumBarBrush" Color="#996366F1" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#06000000" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#10000000" />
            <SolidColorBrush x:Key="SecondaryFillBrush" Color="#08000000" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#0C000000" />
            <SolidColorBrush x:Key="SubtleCardBorderBrush" Color="#06000000" />
            <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#F9FFFFFF" />
            <SolidColorBrush x:Key="GlassCardBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="GlassSubtleBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="GlassStrongBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ModalOverlayBrush" Color="#88000000" />
            <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#146366F1" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#086366F1" />
            <SolidColorBrush x:Key="CardShadowBrush" Color="#0A000020" />
            <SolidColorBrush x:Key="TrackRowAccentBrush" Color="#FF6366F1" />
            <SolidColorBrush x:Key="DividerBrush" Color="#08000000" />

            <!-- ═══════════════════════════════════════════
                 GRADIENT BRUSHES — Rich multi-stop gradients
                 ═══════════════════════════════════════════ -->
            <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6366F1" Offset="0" />
                <GradientStop Color="#FF818CF8" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF5F3FF" Offset="0" />
                <GradientStop Color="#FFEEF2FF" Offset="0.5" />
                <GradientStop Color="#FFF5F0FF" Offset="1" />
            </LinearGradientBrush>

            <!-- Hero: deep indigo → violet → rose, dramatic -->
            <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,0.6">
                <GradientStop Color="#FF4338CA" Offset="0" />
                <GradientStop Color="#FF6366F1" Offset="0.35" />
                <GradientStop Color="#FF8B5CF6" Offset="0.7" />
                <GradientStop Color="#FFA78BFA" Offset="1" />
            </LinearGradientBrush>

            <!-- Hero text overlay: dark bottom fade for readability -->
            <LinearGradientBrush x:Key="HeroTextOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#40000000" Offset="1" />
            </LinearGradientBrush>

            <!-- Glass card depth: subtle white gradient for realism -->
            <LinearGradientBrush x:Key="GlassCardGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFFFF" Offset="0" />
                <GradientStop Color="#FAFFFFFF" Offset="1" />
            </LinearGradientBrush>

            <!-- Cover art placeholder gradient -->
            <LinearGradientBrush x:Key="CoverPlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFEEF0FF" Offset="0" />
                <GradientStop Color="#FFE0E7FF" Offset="1" />
            </LinearGradientBrush>

            <!-- Accent gradient for badges/indicators -->
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF6366F1" Offset="0" />
                <GradientStop Color="#FF818CF8" Offset="1" />
            </LinearGradientBrush>

            <!-- ═══════════════════════════════════════════
                 TYPOGRAPHY — 9-level hierarchy + line heights
                 ═══════════════════════════════════════════ -->
            <x:Double x:Key="FontDisplay">32</x:Double>
            <x:Double x:Key="FontTitle">22</x:Double>
            <x:Double x:Key="FontHeader">20</x:Double>
            <x:Double x:Key="FontSubtitleLG">18</x:Double>
            <x:Double x:Key="FontSubtitle">16</x:Double>
            <x:Double x:Key="FontSubtitleSM">15</x:Double>
            <x:Double x:Key="FontBody">14</x:Double>
            <x:Double x:Key="FontCaption">12</x:Double>
            <x:Double x:Key="FontSmall">11</x:Double>

            <x:Double x:Key="LineHeightDisplay">40</x:Double>
            <x:Double x:Key="LineHeightTitle">28</x:Double>
            <x:Double x:Key="LineHeightSubtitle">22</x:Double>
            <x:Double x:Key="LineHeightBody">20</x:Double>
            <x:Double x:Key="LineHeightCaption">16</x:Double>
            <x:Double x:Key="LineHeightSmall">14</x:Double>

            <!-- ═══════════════════════════════════════════
                 SPACING SYSTEM — 4px base unit
                 ═══════════════════════════════════════════ -->
            <Thickness x:Key="SpaceNone">0</Thickness>
            <Thickness x:Key="SpaceXS">4</Thickness>
            <Thickness x:Key="SpaceSM">8</Thickness>
            <Thickness x:Key="SpaceMD">12</Thickness>
            <Thickness x:Key="SpaceLG">16</Thickness>
            <Thickness x:Key="SpaceXL">20</Thickness>
            <Thickness x:Key="Space2XL">24</Thickness>
            <Thickness x:Key="Space3XL">32</Thickness>

            <x:Double x:Key="GapXS">4</x:Double>
            <x:Double x:Key="Gap2">2</x:Double>
            <x:Double x:Key="Gap6">6</x:Double>
            <x:Double x:Key="GapSM">8</x:Double>
            <x:Double x:Key="Gap10">10</x:Double>
            <x:Double x:Key="GapMD">12</x:Double>
            <x:Double x:Key="Gap14">14</x:Double>
            <x:Double x:Key="GapLG">16</x:Double>
            <x:Double x:Key="Gap18">18</x:Double>
            <x:Double x:Key="GapXL">20</x:Double>
            <x:Double x:Key="Gap2XL">24</x:Double>
            <x:Double x:Key="Gap3XL">32</x:Double>

            <!-- ═══════════════════════════════════════════
                 CORNER RADII
                 ═══════════════════════════════════════════ -->
            <CornerRadius x:Key="RadiusXS">4</CornerRadius>
            <CornerRadius x:Key="RadiusSM">6</CornerRadius>
            <CornerRadius x:Key="RadiusMD">8</CornerRadius>
            <CornerRadius x:Key="RadiusLG">12</CornerRadius>
            <CornerRadius x:Key="RadiusXL">16</CornerRadius>
            <CornerRadius x:Key="Radius14">14</CornerRadius>
            <CornerRadius x:Key="RadiusPlayer">14,14,0,0</CornerRadius>
            <CornerRadius x:Key="RadiusFull">100</CornerRadius>

            <!-- ═══════════════════════════════════════════
                 COVER ART DIMENSIONS
                 ═══════════════════════════════════════════ -->
            <x:Double x:Key="CoverArtList">30</x:Double>
            <x:Double x:Key="CoverArtGame">32</x:Double>
            <x:Double x:Key="CoverArtPlayer">44</x:Double>
            <x:Double x:Key="CoverArtDetail">80</x:Double>
            <x:Double x:Key="CoverArtAlbum">170</x:Double>
            <x:Double x:Key="CoverArtSidebar">52</x:Double>

            <!-- ═══════════════════════════════════════════
                 PADDING TOKENS
                 ═══════════════════════════════════════════ -->
            <Thickness x:Key="PaddingSM">6</Thickness>
            <Thickness x:Key="PaddingMD">10</Thickness>
            <Thickness x:Key="PaddingLG">14</Thickness>
            <Thickness x:Key="PaddingXL">16</Thickness>
            <Thickness x:Key="Padding2XL">20</Thickness>
            <Thickness x:Key="Padding3XL">24</Thickness>
            <Thickness x:Key="Padding4XL">32</Thickness>
            <Thickness x:Key="Padding5XL">36</Thickness>

            <!-- ═══════════════════════════════════════════
                 MOTION TOKENS
                 ═══════════════════════════════════════════ -->
            <x:Double x:Key="DurationFast">0.15</x:Double>
            <x:Double x:Key="DurationNormal">0.25</x:Double>
            <x:Double x:Key="DurationSlow">0.4</x:Double>

            <!-- ═══════════════════════════════════════════
                 ICON SIZING
                 ═══════════════════════════════════════════ -->
            <x:Double x:Key="IconHeroSize">40</x:Double>
            <x:Double x:Key="IconCoverPlaceholderLarge">32</x:Double>
            <x:Double x:Key="IconCoverPlaceholderSize">28</x:Double>
            <x:Double x:Key="IconCoverPlaceholderSmall">18</x:Double>
            <x:Double x:Key="IconPlayPauseSize">22</x:Double>
            <x:Double x:Key="IconNavBarSize">16</x:Double>
            <x:Double x:Key="IconActionSize">14</x:Double>
            <x:Double x:Key="IconSectionIndicator">3</x:Double>

            <!-- ═══════════════════════════════════════════
                 CARD STYLES — Enhanced depth & glass system
                 ═══════════════════════════════════════════ -->

            <!-- Primary card: white glass with subtle gradient + shadow depth -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassCardGradientBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Shadow layer (placed behind card for depth) -->
            <Style x:Key="CardShadowStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardShadowBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
                <Setter Property="Margin" Value="2,2,2,4" />
            </Style>

            <!-- Subtle/secondary card -->
            <Style x:Key="SubtleGlassCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SubtleCardBorderBrush}" />
            </Style>

            <!-- Prominent card with more padding and visible border -->
            <Style x:Key="ProminentCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="Padding" Value="{StaticResource PaddingLG}" />
            </Style>

            <!-- Featured card: top accent stripe -->
            <Style x:Key="FeatureCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource GlassCardGradientBrush}" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Hero card: dramatic gradient -->
            <Style x:Key="HeroCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource HeroGradientBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusXL}" />
                <Setter Property="Padding" Value="{StaticResource Padding3XL}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- ═══════════════════════════════════════════
                 BUTTON HIERARCHY
                 ═══════════════════════════════════════════ -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontSize" Value="{StaticResource FontBody}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="{StaticResource SecondaryFillBrush}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSM}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="CircleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
            </Style>

            <Style x:Key="TransportButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="TransportPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}" />
                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="FontSize" Value="22" />
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,2,0,2" />
            </Style>

            <Style x:Key="NavTabButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Padding" Value="16,8" />
            </Style>

            <Style x:Key="MicroButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
            </Style>

            <!-- ═══════════════════════════════════════════
                 INPUT STYLES
                 ═══════════════════════════════════════════ -->
            <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="{StaticResource FontBody}" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <Style x:Key="AppPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="{StaticResource FontBody}" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="{StaticResource FontBody}" />
            </Style>

            <!-- ═══════════════════════════════════════════
                 TRACK LIST — Enhanced with rounded items & better hover
                 ═══════════════════════════════════════════ -->
            <Style x:Key="TrackListStyle" TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Margin" Value="0,1,0,1" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ListViewItemPresenter
                                            SelectionCheckMarkVisualEnabled="False"
                                            SelectedBackground="{StaticResource PrimarySubtleBrush}"
                                            SelectedForeground="{StaticResource TextPrimaryBrush}"
                                            SelectedPointerOverBackground="{StaticResource PrimarySubtleBrush}"
                                            PointerOverBackground="{StaticResource SecondaryFillBrush}"
                                            PointerOverForeground="{StaticResource TextPrimaryBrush}"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            VerticalContentAlignment="Center" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
