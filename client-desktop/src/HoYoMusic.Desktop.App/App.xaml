<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HoYoMusic.Desktop.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="TextPrimary">#FF1B1F2A</Color>
            <Color x:Key="TextSecondary">#FF66708A</Color>
            <Color x:Key="CardBorder">#80FFFFFF</Color>
            <Color x:Key="SoftBlue">#FF4F8CFF</Color>
            <Color x:Key="SoftPurple">#FF7B61FF</Color>
            <Color x:Key="InputBorder">#FFBCD2FF</Color>

            <LinearGradientBrush x:Key="AuroraLightBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF7FAFF" Offset="0" />
                <GradientStop Color="#FFE8F1FF" Offset="0.45" />
                <GradientStop Color="#FFF3EEFF" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="GlassCardBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="GlassStrongBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="GlassSubtleBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorder}" />

            <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource SoftBlue}" Offset="0" />
                <GradientStop Color="{StaticResource SoftPurple}" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="SubtleGlassCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                <Setter Property="Background" Value="{StaticResource GlassSubtleBrush}" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                <Setter Property="BorderBrush" Value="#22000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="#BFFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            </Style>

            <Style x:Key="CircleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderBrush" Value="#99A8BFFF" />
                <Setter Property="Background" Value="#D9FFFFFF" />
            </Style>

            <Style x:Key="TransportPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                <Setter Property="BorderBrush" Value="#22000000" />
            </Style>

            <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="#E6FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style x:Key="AppPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="#E6FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style x:Key="TrackListStyle" TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="SelectionMode" Value="Single" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
