                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Text="0:00" VerticalAlignment="Center" />
                        <Slider x:Name="ProgressSlider" Grid.Column="2" Minimum="0" Maximum="100" ValueChanged="ProgressSlider_OnValueChanged" PointerPressed="ProgressSlider_OnPointerPressed" PointerReleased="ProgressSlider_OnPointerReleased" />
                        <TextBlock x:Name="DurationText" Grid.Column="3" Foreground="{StaticResource TextSecondaryBrush}" Text="0:00" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="10" Background="#FFE6EEFF" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="正在播放" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding NowPlaying}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                        <Button Click="PrevButton_OnClick" Style="{StaticResource TransportButtonStyle}">
                            <FontIcon Glyph="&#xE892;" FontSize="18" />
                        </Button>
                        <Button Click="PlayPauseButton_OnClick" Style="{StaticResource TransportPrimaryButtonStyle}">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                        </Button>
                        <Button Click="NextButton_OnClick" Style="{StaticResource TransportButtonStyle}">
                            <FontIcon Glyph="&#xE893;" FontSize="18" />
                        </Button>
                        <Button Content="{Binding PlayModeDisplay}" Command="{Binding TogglePlayModeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="AB循环" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <Border Style="{StaticResource GlassCardStyle}" MinWidth="280">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="A-B 区间循环" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBox Header="A(秒)" Text="{Binding AbLoopStartSeconds, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                            <TextBox Header="B(秒)" Text="{Binding AbLoopEndSeconds, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="启用" Command="{Binding EnableAbLoopCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Content="关闭" Command="{Binding DisableAbLoopCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="睡眠" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <Border Style="{StaticResource GlassCardStyle}" MinWidth="240">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="睡眠定时" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBox Header="分钟" Text="{Binding SleepTimerMinutes, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="启动" Command="{Binding StartSleepTimerCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Content="停止" Command="{Binding StopSleepTimerCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="音量" VerticalAlignment="Center" />
                        <Slider x:Name="VolumeSlider" Width="150" ValueChanged="VolumeSlider_OnValueChanged" />
                        <Button Content="曲目详情" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <Border Style="{StaticResource GlassCardStyle}" MinWidth="520" MaxHeight="540">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="曲目详情" />
                                            <InfoBar Grid.Row="1" IsOpen="{Binding ShowTrackDetailStatus}" Severity="Informational" IsClosable="False" Message="{Binding TrackDetailStatusMessage}" />
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding CurrentDetailTrack.Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{Binding CurrentDetailTrack.ArtistsDisplay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CurrentDetailTrack.AlbumTitle}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding DetailLyricsStatus}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding LyricsStyleSummary}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding DetailLyricsPreview}" FontSize="{Binding LyricsFontSize}" TextWrapping="WrapWholeWords" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding DetailCreditsSummary}" TextWrapping="WrapWholeWords" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding DetailMusicSourcesSummary}" TextWrapping="WrapWholeWords" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                                                <Button Content="播放" Command="{Binding PlayCurrentDetailTrackCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                                <Button Content="收藏/取消" Command="{Binding ToggleFavoriteForCurrentDetailTrackCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                                                <Button Content="加到歌单" Command="{Binding AddCurrentDetailTrackToPlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                                                <Button Content="下载" Command="{Binding DownloadCurrentDetailTrackCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="展开/折叠歌词" Command="{Binding ToggleLyricsPreviewExpandedCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="字号+" Command="{Binding IncreaseLyricsFontSizeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="字号-" Command="{Binding DecreaseLyricsFontSizeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="复制歌词" Command="{Binding CopyDetailLyricsTextCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="复制制作" Command="{Binding CopyDetailCreditsTextCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="复制来源" Command="{Binding CopyDetailSourcesTextCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="复制分享" Command="{Binding CopyDetailShareTextCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="定位曲库" Command="{Binding LocateCurrentDetailTrackInLibraryCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="队列" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <Border Style="{StaticResource GlassCardStyle}" MinWidth="360" MaxHeight="420">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="播放队列" />
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                <TextBox Width="160" PlaceholderText="筛选队列" Text="{Binding QueueFilterText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                <ToggleSwitch Header="去重" IsOn="{Binding PreventDuplicateQueueItems, Mode=TwoWay}" />
                                                <ToggleSwitch Header="自动播" IsOn="{Binding QueueAutoPlayOnAdd, Mode=TwoWay}" />
                                                <Button Content="反转" Command="{Binding ReverseQueueCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="随机" Command="{Binding ShuffleQueueCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="保存为歌单" Command="{Binding SaveQueueAsPlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAuthenticated}" />
                                                <Button Content="导出队列" Command="{Binding ExportQueueTextCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                            <ListView Grid.Row="2" ItemsSource="{Binding PlaybackQueueView}" Style="{StaticResource TrackListStyle}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding DurationDisplay}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="播放" Command="{Binding DataContext.PlayQueueItemByIdCommand, ElementName=RootGrid}" CommandParameter="{Binding Id}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                                                            <Button Grid.Column="2" Content="上移" Command="{Binding DataContext.MoveQueueItemUpCommand, ElementName=RootGrid}" CommandParameter="{Binding Id}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                                                            <Button Grid.Column="3" Content="下移" Command="{Binding DataContext.MoveQueueItemDownCommand, ElementName=RootGrid}" CommandParameter="{Binding Id}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                                                            <Button Grid.Column="4" Content="移除" Command="{Binding DataContext.RemoveQueueItemCommand, ElementName=RootGrid}" CommandParameter="{Binding Id}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Button Grid.Row="3" Content="清空队列" Command="{Binding ClearQueueCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Visibility="{Binding ShowComplianceFooter, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="备案信息：" />
                        <Button Content="{Binding ComplianceIcpNumber}" Command="{Binding OpenComplianceLinkCommand}" CommandParameter="{Binding ComplianceIcpUrl}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                        <Button Content="{Binding CompliancePublicSecurityNumber}" Command="{Binding OpenComplianceLinkCommand}" CommandParameter="{Binding CompliancePublicSecurityUrl}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                    </StackPanel>

                    <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="False" Opacity="0" IsHitTestVisible="False" Width="1" Height="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
