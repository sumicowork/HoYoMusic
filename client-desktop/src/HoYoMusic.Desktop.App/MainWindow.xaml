<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HoYoMusic.Desktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:HoYoMusic.Desktop.App.Controls"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="{StaticResource AuroraLightBackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainGridColumn0.Width" Value="60" />
                        <Setter Target="LeftSideBar.IsCompact" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:HoYoTitleBar x:Name="TitleBarControl" Grid.Row="0" Margin="16,10,16,2" />

        <Grid Grid.Row="1" Margin="16,8,16,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainGridColumn0" Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:HoYoSideBar x:Name="LeftSideBar" Grid.Column="0" />
            <controls:HoYoMainContent x:Name="MainContentControl" Grid.Column="1" />

            <Border Grid.ColumnSpan="2"
                    Background="{ThemeResource SystemControlPageBackgroundMediumAltMediumBrush}"
                    CornerRadius="16"
                    Padding="24"
                    Visibility="{Binding ShowMaintenanceOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource GlassCardStyle}" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="{StaticResource PrimaryGradientBrush}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="站点维护中" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding MaintenanceMessage}" TextWrapping="WrapWholeWords" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding MaintenanceExpectedEndTimeText}" TextWrapping="WrapWholeWords" />
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="维护期间你仍可浏览已登录账户，但公共浏览入口将暂时受限。" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Border>

            <Border Grid.ColumnSpan="2"
                    Background="{ThemeResource SystemControlPageBackgroundMediumAltMediumBrush}"
                    CornerRadius="16"
                    Padding="24"
                    Visibility="{Binding ShowFirstVisitModal, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource GlassCardStyle}" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9CE;" FontSize="32" Foreground="{StaticResource PrimaryGradientBrush}" />
                            <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding FirstVisitTitle}" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,10">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" LineHeight="24" Text="{Binding FirstVisitContent}" TextWrapping="WrapWholeWords" />
                        </ScrollViewer>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding FirstVisitCountdownDisplay}" />
                            <Button HorizontalAlignment="Right" Content="我已阅读并继续" Command="{Binding AcknowledgeFirstVisitCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding FirstVisitAcknowledgeEnabled}" Padding="24,8" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <controls:HoYoPlayerBar x:Name="PlayerBar" Grid.Row="2" Margin="20,0,20,12" />
    </Grid>
</Window>
