<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HoYoMusic.Desktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="{StaticResource AuroraLightBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Margin="16,10,16,2">
            <Border Style="{StaticResource GlassCardStyle}" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource PrimaryGradientBrush}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="HoYoMusic" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="游戏音乐档案馆" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="快捷键" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Style="{StaticResource GlassCardStyle}" MinWidth="300">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="快捷键帮助" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Space: 播放/暂停" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="Left/Right: 上一首/下一首" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="M: 静音切换" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="L: 切换播放模式" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="Esc: 返回发现页" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="{Binding UnreadMessageBadge}" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Style="{StaticResource GlassCardStyle}" MinWidth="420" MaxHeight="520">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="刷新" Command="{Binding RefreshInboxCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="全部已读" Command="{Binding MarkAllMessagesReadCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <ToggleSwitch Header="仅未读" IsOn="{Binding ShowUnreadOnly, Mode=TwoWay}" Toggled="InboxFilter_OnToggled" />
                                                <TextBox Width="140" PlaceholderText="搜索消息" Text="{Binding MessageSearchText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                            </StackPanel>
                                            <InfoBar Grid.Row="1" IsClosable="False" Severity="Informational" Message="{Binding InboxStatusMessage}" IsOpen="{Binding ShowInboxStatus}" />
                                            <Grid Grid.Row="2" RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                            <ListView Grid.Row="0" ItemsSource="{Binding InboxMessages}" Style="{StaticResource TrackListStyle}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource SubtleGlassCardStyle}" Margin="0,0,0,8" Padding="10">
                                                            <Grid RowSpacing="6">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                                    <Button Grid.Column="1" Content="已读" Command="{Binding DataContext.MarkMessageReadCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Text="{Binding Content}" TextWrapping="WrapWholeWords" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <TextBlock Grid.Row="2" Text="{Binding Meta}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                    <Button Content="上一页" Command="{Binding PreviousInboxPageCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding HasPreviousInboxPage}" />
                                                    <TextBlock Text="{Binding InboxPaginationSummary}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <Button Content="下一页" Command="{Binding NextInboxPageCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding HasNextInboxPage}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="账户" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Style="{StaticResource GlassCardStyle}" MinWidth="320">
                                        <StackPanel Spacing="8">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="账户" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding CurrentUserDisplay}" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="登录" />
                                        <TextBox Header="账号" Text="{Binding Identifier, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <PasswordBox x:Name="PasswordInput" Header="密码" PasswordChanged="PasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                        <Button Content="登录" Click="LoginButton_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button Content="退出登录" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <PasswordBox x:Name="CurrentPasswordInput" Header="当前密码" PasswordChanged="CurrentPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                        <PasswordBox x:Name="NewPasswordInput" Header="新密码" PasswordChanged="NewPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                        <Button Content="修改密码" Command="{Binding ChangePasswordCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Rectangle Height="1" Fill="#22000000" Margin="0,6,0,6" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="注册" />
                                        <TextBox Header="用户名" Text="{Binding RegisterUsername, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <TextBox Header="邮箱" Text="{Binding RegisterEmail, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox Width="190" Header="验证码" Text="{Binding VerificationCode, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                            <Button Content="发送验证码" Command="{Binding SendVerificationCodeCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <PasswordBox x:Name="RegisterPasswordInput" Header="注册密码" PasswordChanged="RegisterPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                        <PasswordBox x:Name="RegisterConfirmPasswordInput" Header="确认密码" PasswordChanged="RegisterConfirmPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                        <Button Content="注册并登录" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="16,8,16,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="游戏" />
                        <ListView
                            ItemsSource="{Binding Games}"
                            SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            MinHeight="260"
                            Width="60"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ListViewItemPresenter
                                                    Padding="0"
                                                    ContentMargin="0"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    SelectionCheckMarkVisualEnabled="False" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GlassCardStyle}" Padding="6" HorizontalAlignment="Center">
                                        <ToolTipService.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding StatusDisplay}" />
                                            </StackPanel>
                                        </ToolTipService.ToolTip>
                                        <Grid Width="48" Height="48">
                                            <Border CornerRadius="12" Background="{StaticResource PrimaryGradientBrush}">
                                                <FontIcon Glyph="&#xE7FC;" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border CornerRadius="12">
                                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" ImageOpened="GameCoverImage_OnImageOpened" ImageFailed="GameCoverImage_OnImageFailed" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="当前内容" />
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding NowPlaying}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing Width="14" Height="14" IsActive="{Binding IsBusy}" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding CurrentUserDisplay}" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding LoadingStage}" />
                            </StackPanel>
                        </Grid>
                        <InfoBar Grid.Row="1" IsClosable="False" Severity="Error" Message="{Binding ErrorMessage}" IsOpen="{Binding HasErrorMessage}" />
                        <InfoBar Grid.Row="2" IsClosable="True" CloseButtonClick="SuccessInfoBar_OnClose" Severity="Success" Message="{Binding SuccessMessage}" IsOpen="{Binding ShowSuccessMessage}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="10">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="发现" Command="{Binding OpenSectionCommand}" CommandParameter="discover" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="曲库" Command="{Binding OpenSectionCommand}" CommandParameter="library" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="收藏" Command="{Binding OpenSectionCommand}" CommandParameter="favorites" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="歌单" Command="{Binding OpenSectionCommand}" CommandParameter="playlists" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="个人" Command="{Binding OpenSectionCommand}" CommandParameter="profile" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="下载" Command="{Binding OpenSectionCommand}" CommandParameter="downloads" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Name="AdminNavButton" Content="管理" Command="{Binding OpenSectionCommand}" CommandParameter="admin" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <Grid x:Name="DiscoverSectionPanel" Visibility="Visible">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource GlassCardStyle}" Background="{StaticResource GlassStrongBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Text="发现" />
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding SelectedGameSummary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="刷新" Command="{Binding RefreshDiscoverCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <TextBox Width="160" PlaceholderText="筛选发现曲目" Text="{Binding DiscoverFilterText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                                <ComboBox Width="92" SelectedItem="{Binding DiscoverRandomCount, Mode=TwoWay}">
                                                    <x:Int32>5</x:Int32>
                                                    <x:Int32>10</x:Int32>
                                                    <x:Int32>15</x:Int32>
                                                    <x:Int32>20</x:Int32>
                                                    <x:Int32>30</x:Int32>
                                                </ComboBox>
                                                <Button Content="刷新随机" Command="{Binding RefreshRandomTracksCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <ComboBox Width="92" SelectedItem="{Binding DiscoverTopCount, Mode=TwoWay}">
                                                    <x:Int32>5</x:Int32>
                                                    <x:Int32>10</x:Int32>
                                                    <x:Int32>20</x:Int32>
                                                    <x:Int32>50</x:Int32>
                                                    <x:Int32>100</x:Int32>
                                                </ComboBox>
                                                <Button Content="刷新热门" Command="{Binding RefreshTopTracksCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="播放筛选" Command="{Binding PlayFilteredDiscoverTracksCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="播放当前游戏" Command="{Binding PlaySelectedGameAllCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <InfoBar Grid.Row="0" IsOpen="{Binding ShowDiscoverStatus}" Severity="Informational" IsClosable="False" Message="{Binding DiscoverStatusMessage}" />

                                            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Background="{StaticResource GlassStrongBrush}" Padding="14">
                                                <Grid RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Text="推荐专辑" />
                                                        <Button Grid.Column="1" Content="播放选中专辑" Command="{Binding QuickPlayAlbumCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                                    </Grid>
                                                    <ListView Grid.Row="1" Style="{StaticResource TrackListStyle}" ItemsSource="{Binding SelectedGameAlbums}" SelectedItem="{Binding SelectedGameAlbum, Mode=TwoWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="DiscoverAlbumsList_OnItemClick" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                        <ListView.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <ItemsStackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ListView.ItemsPanel>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Width="220" Margin="0,0,14,0" RowSpacing="8">
                                                                    <Grid RenderTransformOrigin="0.5,0.5" PointerEntered="AlbumCard_OnPointerEntered" PointerExited="AlbumCard_OnPointerExited">
                                                                        <Grid.RenderTransform>
                                                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                        </Grid.RenderTransform>
                                                                        <Button Command="{Binding DataContext.OpenAlbumDetailCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0">
                                                                            <Border Style="{StaticResource SubtleGlassCardStyle}" Width="220" Height="248" Padding="8">
                                                                                <Grid RowSpacing="8">
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="*" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                        <RowDefinition Height="Auto" />
                                                                                    </Grid.RowDefinitions>
                                                                                    <Border CornerRadius="10" Background="#FFEAF1FF">
                                                                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                                                    </Border>
                                                                                    <TextBlock Grid.Row="1" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="WrapWholeWords" MaxLines="2" />
                                                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="曲目" />
                                                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding TrackCount}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Button>
                                                                        <Border x:Name="AlbumPlayOverlay" Opacity="0" Width="220" Height="248" CornerRadius="14" Background="#2F000000" IsHitTestVisible="False">
                                                                            <Grid>
                                                                                <Border Width="48" Height="48" CornerRadius="24" Background="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="#FF2F3B57" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>
                                                                    <Button Grid.Row="1" Content="立即播放" Command="{Binding DataContext.QuickPlayAlbumCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="2" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="12">
                                                    <Grid RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="随机推荐曲目" />
                                                        <ListView Grid.Row="1" Style="{StaticResource TrackListStyle}" ItemsSource="{Binding RandomTracksView}">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AlbumTitle}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="播放" Command="{Binding DataContext.PlayRandomTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" />
                                                                        <Button Grid.Column="2" Content="详情" Command="{Binding DataContext.OpenDiscoverTrackDetailCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" />
                                                                        <Button Grid.Column="3" Content="收藏" Command="{Binding DataContext.ToggleFavoriteForDiscoverTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" IsEnabled="{Binding DataContext.IsAuthenticated, ElementName=RootGrid}" />
                                                                        <Button Grid.Column="4" Content="队列" Command="{Binding DataContext.EnqueueDiscoverTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" />
                                                                        <Button Grid.Column="5" Content="下首" Command="{Binding DataContext.PlayDiscoverTrackNextCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="12">
                                                    <Grid RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="热门曲目" />
                                                        <ListView Grid.Row="1" Style="{StaticResource TrackListStyle}" ItemsSource="{Binding TopTracksView}">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding PlayCount}" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="播放" Command="{Binding DataContext.PlayTopTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" />
                                                                        <Button Grid.Column="2" Content="详情" Command="{Binding DataContext.OpenDiscoverTrackDetailCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" />
                                                                        <Button Grid.Column="3" Content="收藏" Command="{Binding DataContext.ToggleFavoriteForDiscoverTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" IsEnabled="{Binding DataContext.IsAuthenticated, ElementName=RootGrid}" />
                                                                        <Button Grid.Column="4" Content="队列" Command="{Binding DataContext.EnqueueDiscoverTrackCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" />
                                                                        <Button Grid.Column="5" Content="下首" Command="{Binding DataContext.PlayDiscoverTrackNextCommand, ElementName=RootGrid}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <Grid x:Name="AlbumDetailSectionPanel" Visibility="Collapsed">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="← 返回发现" Command="{Binding BackToDiscoverCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="播放专辑" Command="{Binding PlayAlbumAllCommand}" Style="{StaticResource PrimaryButtonStyle}" />
