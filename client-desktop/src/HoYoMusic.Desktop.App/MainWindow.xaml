<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HoYoMusic.Desktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:HoYoMusic.Desktop.App.Controls"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NormalState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftSideBar.IsCompact" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: Title Bar ═══ -->
        <controls:HoYoTitleBar x:Name="TitleBarControl" Grid.Row="0" Margin="12,8,12,0" />

        <!-- ═══ ROW 1: Spotify-style 3-column layout ═══ -->
        <Grid Grid.Row="1" Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideBarColumn" Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DrawerColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ─── Left: Spotify Navigation Sidebar ─── -->
            <controls:HoYoSideBar x:Name="LeftSideBar" Grid.Column="0" Margin="0,0,4,0" />

            <!-- ─── Center: Main Content ─── -->
            <controls:HoYoMainContent x:Name="MainContentControl" Grid.Column="1" Margin="4,0,4,0" />

            <!-- ─── Right: Context Drawer (Spotify-style slide-in panel) ─── -->
            <Border Grid.Column="2" Width="380" Margin="4,0,0,0"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0"
                    CornerRadius="{StaticResource RadiusLG}"
                    Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Grid Grid.Row="0" Padding="16,12,12,8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DrawerTitleText" FontSize="{StaticResource FontSubtitleSM}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" FontFamily="Segoe MDL2 Assets" Content="&#xE711;"
                                Style="{StaticResource IconButtonStyle}" FontSize="{StaticResource IconActionSize}"
                                Command="{Binding CloseDrawerCommand}" AutomationProperties.Name="关闭面板" />
                    </Grid>

                    <!-- Drawer Body: Queue Panel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsQueueDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid RowSpacing="{StaticResource Gap10}" Padding="16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Queue search + options -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="搜索队列" Text="{Binding QueueFilterText, Mode=TwoWay}"
                                         Style="{StaticResource AppTextBoxStyle}" />
                                <Button Grid.Column="1" FontFamily="Segoe MDL2 Assets" Content="&#xE712;"
                                        Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <ToggleMenuFlyoutItem Text="过滤重复项" IsChecked="{Binding PreventDuplicateQueueItems, Mode=TwoWay}" />
                                            <ToggleMenuFlyoutItem Text="添加时自动播放" IsChecked="{Binding QueueAutoPlayOnAdd, Mode=TwoWay}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="保存为歌单" Command="{Binding SaveQueueAsPlaylistCommand}" />
                                            <MenuFlyoutItem Text="导出清单" Command="{Binding ExportQueueTextCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <!-- Queue list -->
                            <ListView Grid.Row="1" ItemsSource="{Binding PlaybackQueueView}"
                                      Style="{StaticResource TrackListStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="{StaticResource GapSM}" Margin="0,0,0,2" MinHeight="36">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DurationDisplay}" FontSize="{StaticResource FontSmall}"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" FontFamily="Segoe MDL2 Assets" Content="&#xE768;"
                                                    FontSize="{StaticResource FontSmall}" Style="{StaticResource GhostButtonStyle}"
                                                    Padding="{StaticResource SpaceXS}"
                                                    Command="{Binding DataContext.PlayQueueItemByIdCommand, ElementName=RootGrid}"
                                                    CommandParameter="{Binding Id}" AutomationProperties.Name="播放此曲目" />
                                            <Button Grid.Column="2" FontFamily="Segoe MDL2 Assets" Content="&#xE712;"
                                                    FontSize="{StaticResource FontSmall}" Style="{StaticResource GhostButtonStyle}"
                                                    Padding="{StaticResource SpaceXS}" AutomationProperties.Name="队列操作菜单">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="上移" Icon="Up"
                                                            Command="{Binding DataContext.MoveQueueItemUpCommand, ElementName=RootGrid}"
                                                            CommandParameter="{Binding Id}" />
                                                        <MenuFlyoutItem Text="下移" Icon="Down"
                                                            Command="{Binding DataContext.MoveQueueItemDownCommand, ElementName=RootGrid}"
                                                            CommandParameter="{Binding Id}" />
                                                        <MenuFlyoutItem Text="移除" Icon="Delete"
                                                            Command="{Binding DataContext.RemoveQueueItemCommand, ElementName=RootGrid}"
                                                            CommandParameter="{Binding Id}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <!-- Queue footer actions -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource GapSM}"
                                        HorizontalAlignment="Center">
                                <Button Content="反转" Command="{Binding ReverseQueueCommand}" Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="打乱" Command="{Binding ShuffleQueueCommand}" Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="清空" Command="{Binding ClearQueueCommand}" Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                            <!-- Queue empty state -->
                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontBody}"
                                       Text="队列是空的"
                                       Visibility="{Binding HasPlaybackQueueInverse, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </ScrollViewer>

                    <!-- Drawer Body: Now Playing / Track Detail Panel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsNowPlayingDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="{StaticResource Gap10}" Padding="16,12">
                            <!-- Cover art (larger for drawer) -->
                            <Border Width="200" Height="200" CornerRadius="{StaticResource RadiusMD}" HorizontalAlignment="Center"
                                    Background="{StaticResource PrimarySubtleBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE8D4;" FontSize="48" Foreground="{StaticResource PrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border CornerRadius="{StaticResource RadiusMD}">
                                        <Image Source="{Binding CurrentDetailTrack.CoverPath}" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- Track info -->
                            <TextBlock Text="{Binding CurrentDetailTrack.Title}" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSubtitleLG}" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="WrapWholeWords" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentDetailTrack.ArtistsDisplay}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" />
                            <TextBlock Text="{Binding CurrentDetailTrack.AlbumTitle}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontCaption}" />
                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}" HorizontalAlignment="Center">
                                <Button Content="播放" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding PlayCurrentDetailTrackCommand}" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ToggleFavoriteForCurrentDetailTrackCommand}"
                                        ToolTipService.ToolTip="收藏" AutomationProperties.Name="收藏">
                                    <FontIcon Glyph="&#xE735;" FontSize="{StaticResource IconActionSize}" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding AddCurrentDetailTrackToPlaylistCommand}"
                                        ToolTipService.ToolTip="加到歌单" AutomationProperties.Name="加到歌单">
                                    <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconActionSize}" />
                                </Button>
                            </StackPanel>
                            <!-- Lyrics section -->
                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}">
                                <StackPanel Spacing="{StaticResource Gap6}">
                                    <Grid>
                                        <TextBlock Text="歌词" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                            <Button Style="{StaticResource MicroButtonStyle}" Content="展开"
                                                    Command="{Binding ToggleLyricsPreviewExpandedCommand}" />
                                            <Button Style="{StaticResource MicroButtonStyle}" Content="A+"
                                                    Command="{Binding IncreaseLyricsFontSizeCommand}" />
                                            <Button Style="{StaticResource MicroButtonStyle}" Content="A-"
                                                    Command="{Binding DecreaseLyricsFontSizeCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding DetailLyricsStatus}"
                                               Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSmall}" />
                                    <TextBlock Text="{Binding DetailLyricsPreview}"
                                               FontSize="{Binding LyricsFontSize}" TextWrapping="WrapWholeWords"
                                               Foreground="{StaticResource TextPrimaryBrush}" LineHeight="{StaticResource LineHeightSubtitle}" />
                                </StackPanel>
                            </Border>
                            <!-- Credits section -->
                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}"
                                    Visibility="{Binding DetailCreditsSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="{StaticResource GapXS}">
                                    <TextBlock Text="制作人员" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontCaption}" />
                                    <TextBlock Text="{Binding DetailCreditsSummary}" TextWrapping="WrapWholeWords"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSmall}" />
                                </StackPanel>
                            </Border>
                            <!-- Music Sources section -->
                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}"
                                    Visibility="{Binding DetailMusicSourcesSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="{StaticResource GapXS}">
                                    <TextBlock Text="音乐来源" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontCaption}" />
                                    <TextBlock Text="{Binding DetailMusicSourcesSummary}" TextWrapping="WrapWholeWords"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSmall}" />
                                </StackPanel>
                            </Border>
                            <!-- Share -->
                            <Button Content="复制分享文本" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center"
                                    Command="{Binding CopyDetailShareTextCommand}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Body: Enhancements Panel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEnhancementsDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="{StaticResource Gap10}" Padding="16,12">
                            <!-- Equalizer -->
                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}">
                                <StackPanel Spacing="{StaticResource Gap6}">
                                    <Grid>
                                        <TextBlock Text="均衡器" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <ToggleSwitch IsOn="{Binding EqualizerEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <StackPanel Visibility="{Binding EqualizerEnabled, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="{StaticResource Gap6}">
                                        <ComboBox Header="预设" ItemsSource="{Binding EqualizerPresets}"
                                                  SelectedItem="{Binding EqualizerPreset, Mode=TwoWay}" Style="{StaticResource AppComboBoxStyle}"
                                                  HorizontalAlignment="Stretch" />
                                        <Grid ColumnSpacing="{StaticResource Gap6}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Header="低频" Text="{Binding EqualizerLowGain, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                            <TextBox Grid.Column="1" Header="中频" Text="{Binding EqualizerMidGain, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                            <TextBox Grid.Column="2" Header="高频" Text="{Binding EqualizerHighGain, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Crossfade -->
                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="淡入淡出" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Slider Value="{Binding CrossfadeSeconds, Mode=TwoWay}" Minimum="1" Maximum="15" />
                                        <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSmall}">
                                            <Run Text="当前：" /><Run Text="{Binding CrossfadeSeconds}" />
                                            <Run Text=" 秒" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ToggleSwitch IsOn="{Binding CrossfadeEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <!-- Spectrum -->
                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}">
                                <Grid>
                                    <TextBlock Text="频谱可视化" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <ToggleSwitch IsOn="{Binding SpectrumEnabled, Mode=TwoWay}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                            <!-- Sleep Timer -->
                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}">
                                <StackPanel Spacing="{StaticResource Gap6}">
                                    <TextBlock Text="睡眠定时" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Grid ColumnSpacing="{StaticResource Gap6}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="分钟" Text="{Binding SleepTimerMinutes, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <Button Grid.Column="1" Content="启动" Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding StartSleepTimerCommand}" VerticalAlignment="Bottom" />
                                        <Button Grid.Column="2" Content="停止" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding StopSleepTimerCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapXS}">
                                        <Button Content="15分" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding ApplySleepTimerPresetCommand}" CommandParameter="15" />
                                        <Button Content="30分" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding ApplySleepTimerPresetCommand}" CommandParameter="30" />
                                        <Button Content="60分" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding ApplySleepTimerPresetCommand}" CommandParameter="60" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- AB Loop -->
                            <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}">
                                <StackPanel Spacing="{StaticResource Gap6}">
                                    <TextBlock Text="A-B 循环" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Grid ColumnSpacing="{StaticResource Gap6}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="A-秒" Text="{Binding AbLoopStartSeconds, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <TextBox Grid.Column="1" Header="B-秒" Text="{Binding AbLoopEndSeconds, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <Button Grid.Column="2" Content="启用" Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding EnableAbLoopCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Button Content="关闭" Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding DisableAbLoopCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Body: Account Panel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsAccountDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="{StaticResource Gap14}" Padding="16,12">
                            <Grid>
                                <TextBlock FontSize="{StaticResource FontSubtitle}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="账户中心" VerticalAlignment="Center" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrush}"
                                           Text="{Binding CurrentUserDisplay}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Error message inside drawer -->
                            <InfoBar IsClosable="True" Severity="Error" Message="{Binding ErrorMessage}"
                                     IsOpen="{Binding HasErrorMessage}" />

                            <!-- Authenticated: User card + logout + security -->
                            <StackPanel Spacing="{StaticResource Gap10}"
                                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingMD}">
                                    <StackPanel Spacing="{StaticResource Gap6}">
                                        <TextBlock FontSize="{StaticResource FontSubtitleSM}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding CurrentUserDisplay}" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSmall}"
                                                   Text="已登录" />
                                    </StackPanel>
                                </Border>
                                <Pivot>
                                    <PivotItem Header="安全" Margin="0,8,0,0">
                                        <StackPanel Spacing="{StaticResource Gap10}">
                                            <PasswordBox x:Name="DrawerCurrentPasswordInput" Header="当前密码" PlaceholderText="验证身份"
                                                         PasswordChanged="DrawerCurrentPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                            <PasswordBox x:Name="DrawerNewPasswordInput" Header="新密码" PlaceholderText="设置新密码"
                                                         PasswordChanged="DrawerNewPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                            <Button HorizontalAlignment="Right" Content="保存修改" Command="{Binding ChangePasswordCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </PivotItem>
                                </Pivot>
                                <Button HorizontalAlignment="Stretch" Content="退出登录" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Unauthenticated: Login / Register tabs -->
                            <Pivot Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                <PivotItem Header="登录" Margin="0,8,0,0">
                                    <StackPanel Spacing="{StaticResource Gap10}">
                                        <TextBox Header="账号" PlaceholderText="邮箱或用户名" Text="{Binding Identifier, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <PasswordBox x:Name="DrawerPasswordInput" Header="密码" PlaceholderText="输入密码"
                                                     PasswordChanged="DrawerPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                        <Button HorizontalAlignment="Right" Content="立刻登录" Click="DrawerLoginButton_OnClick" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" Margin="0,6,0,0" />
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem Header="注册" Margin="0,8,0,0">
                                    <StackPanel Spacing="{StaticResource Gap10}">
                                        <TextBox Header="用户名" PlaceholderText="设置昵称" Text="{Binding RegisterUsername, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <TextBox Header="邮箱" PlaceholderText="用于找回密码" Text="{Binding RegisterEmail, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                        <Grid ColumnSpacing="{StaticResource GapSM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Header="验证码" PlaceholderText="6位代码" Text="{Binding VerificationCode, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                            <Button Grid.Column="1" Content="获取验证码" Command="{Binding SendVerificationCodeCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <PasswordBox x:Name="DrawerRegisterPasswordInput" Header="密码" PlaceholderText="设置密码"
                                                     PasswordChanged="DrawerRegisterPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                        <PasswordBox x:Name="DrawerRegisterConfirmPasswordInput" Header="确认密码" PlaceholderText="再次输入密码"
                                                     PasswordChanged="DrawerRegisterConfirmPasswordInput_OnPasswordChanged" Style="{StaticResource AppPasswordBoxStyle}" />
                                        <Button HorizontalAlignment="Right" Content="注册并登录" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" Margin="0,6,0,0" />
                                    </StackPanel>
                                </PivotItem>
                            </Pivot>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Body: Inbox Panel -->
                    <Grid Grid.Row="1" RowSpacing="{StaticResource GapSM}" Padding="16,12"
                          Visibility="{Binding IsInboxDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="{StaticResource Gap6}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap6}">
                                <Button Content="刷新" Command="{Binding RefreshInboxCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="全部已读" Command="{Binding MarkAllMessagesReadCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="{StaticResource Gap6}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="搜索消息" Text="{Binding MessageSearchText, Mode=TwoWay}" Style="{StaticResource AppTextBoxStyle}" />
                                <ToggleSwitch Grid.Column="1" Header="仅未读" IsOn="{Binding ShowUnreadOnly, Mode=TwoWay}"
                                              Toggled="DrawerInboxFilter_OnToggled" />
                            </Grid>
                        </StackPanel>
                        <InfoBar Grid.Row="1" IsClosable="False" Severity="Informational"
                                 Message="{Binding InboxStatusMessage}" IsOpen="{Binding ShowInboxStatus}" />
                        <ListView Grid.Row="2" ItemsSource="{Binding InboxMessages}" Style="{StaticResource TrackListStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleGlassCardStyle}" Margin="0,0,0,4" Padding="{StaticResource SpaceSM}">
                                        <Grid RowSpacing="{StaticResource GapXS}">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontBody}" />
                                                <Button HorizontalAlignment="Right" Content="已读"
                                                        Command="{Binding DataContext.MarkMessageReadCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}" Style="{StaticResource MicroButtonStyle}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Content}" TextWrapping="WrapWholeWords"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                                            <TextBlock Grid.Row="2" Text="{Binding Meta}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSmall}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Gap6}">
                            <Button Content="上一页" Command="{Binding PreviousInboxPageCommand}" Style="{StaticResource GhostButtonStyle}"
                                    FontSize="{StaticResource FontSmall}" IsEnabled="{Binding HasPreviousInboxPage}" />
                            <TextBlock Text="{Binding InboxPaginationSummary}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSmall}" />
                            <Button Content="下一页" Command="{Binding NextInboxPageCommand}" Style="{StaticResource GhostButtonStyle}"
                                    FontSize="{StaticResource FontSmall}" IsEnabled="{Binding HasNextInboxPage}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─── Overlay: Maintenance Mode ─── -->
            <Border Grid.ColumnSpan="3" Background="{StaticResource ModalOverlayBrush}"
                    Visibility="{Binding ShowMaintenanceOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource GlassCardStyle}" MaxWidth="460"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource Padding4XL}">
                    <StackPanel Spacing="{StaticResource Gap14}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource IconHeroSize}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="{StaticResource FontHeader}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Text="站点维护中" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding MaintenanceMessage}" TextWrapping="WrapWholeWords" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="{Binding MaintenanceExpectedEndTimeText}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- ─── Overlay: First Visit Modal ─── -->
            <Border Grid.ColumnSpan="3" Background="{StaticResource ModalOverlayBrush}"
                    Visibility="{Binding ShowFirstVisitModal, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource GlassCardStyle}" MaxWidth="520"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource Padding5XL}">
                    <StackPanel Spacing="{StaticResource Gap18}">
                        <FontIcon Glyph="&#xE9CE;" FontSize="{StaticResource IconCoverPlaceholderLarge}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="{StaticResource FontTitle}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding FirstVisitTitle}" TextWrapping="WrapWholeWords" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSubtitleSM}"
                                       Text="{Binding FirstVisitContent}" TextWrapping="WrapWholeWords" />
                        </ScrollViewer>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"
                                       Text="{Binding FirstVisitCountdownDisplay}" />
                            <Button HorizontalAlignment="Right" Content="我已阅读并继续"
                                    Command="{Binding AcknowledgeFirstVisitCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding FirstVisitAcknowledgeEnabled}" Padding="24,10"
                                    AutomationProperties.Name="确认并继续" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ═══ ROW 2: Player Bar ═══ -->
        <controls:HoYoPlayerBar x:Name="PlayerBar" Grid.Row="2" Margin="8,0,8,8" />
    </Grid>
</Window>
