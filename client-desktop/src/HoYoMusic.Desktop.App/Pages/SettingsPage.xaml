<Page
    x:Class="HoYoMusic.Desktop.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource Gap2XL}" Padding="4,0,12,32">

            <!-- Hero header -->
            <Border Style="{StaticResource HeroCardStyle}" MinHeight="100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource GapSM}" VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontDisplay}" FontWeight="Bold"
                                   Foreground="{StaticResource TextInverseBrush}" Text="设置" />
                        <TextBlock FontSize="{StaticResource FontSubtitle}" Foreground="#CCFFFFFF"
                                   Text="管理你的偏好、外观与反馈" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE713;" FontSize="60" Foreground="#15FFFFFF"
                              VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                </Grid>
            </Border>

            <!-- Account Info -->
            <Grid>
                <Border Style="{StaticResource CardShadowStyle}" />
                <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource Padding2XL}">
                    <StackPanel Spacing="{StaticResource GapMD}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                    Background="{StaticResource PrimarySubtleBrush}">
                                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="账户信息" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource SubtleGlassCardStyle}" Padding="{StaticResource PaddingXL}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding CurrentUserDisplay}" FontSize="{StaticResource FontSubtitle}"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ProfileSummary}" FontSize="{StaticResource FontCaption}"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding QueueBehaviorSummary}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Appearance: Theme -->
            <Grid>
                <Border Style="{StaticResource CardShadowStyle}" />
                <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource Padding2XL}">
                    <StackPanel Spacing="{StaticResource GapMD}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                    Background="{StaticResource AccentSubtleBrush}">
                                <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="外观主题" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnSpacing="{StaticResource GapMD}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" HorizontalAlignment="Stretch"
                                    Command="{Binding SetThemeModeCommand}" CommandParameter="light"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,14">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE706;" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="浅色" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" HorizontalAlignment="Stretch"
                                    Command="{Binding SetThemeModeCommand}" CommandParameter="dark"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,14">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE708;" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="深色" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" HorizontalAlignment="Stretch"
                                    Command="{Binding SetThemeModeCommand}" CommandParameter="system"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="12,14">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="跟随系统" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Data Management -->
            <Grid>
                <Border Style="{StaticResource CardShadowStyle}" />
                <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource Padding2XL}">
                    <StackPanel Spacing="{StaticResource GapMD}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                    Background="{StaticResource PrimarySubtleBrush}">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="数据管理" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="重置所有本地设置为默认值（不影响服务端数据）"
                                   FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextTertiaryBrush}" />
                        <Button Content="&#xE74D; 重置所有设置" Command="{Binding ResetAllSettingsCommand}"
                                Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Padding="14,8" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Feedback -->
            <Grid>
                <Border Style="{StaticResource CardShadowStyle}" />
                <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource Padding2XL}">
                    <StackPanel Spacing="{StaticResource GapMD}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusFull}"
                                    Background="{StaticResource AccentSubtleBrush}">
                                <FontIcon Glyph="&#xED15;" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="反馈与建议" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox Header="联系方式（可选）" Text="{Binding FeedbackContact, Mode=TwoWay}"
                                 Style="{StaticResource AppTextBoxStyle}" />
                        <TextBox Header="反馈内容" Text="{Binding FeedbackContent, Mode=TwoWay}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Style="{StaticResource AppTextBoxStyle}" />
                        <Button Content="&#xE724; 提交反馈" Command="{Binding SubmitFeedbackCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="20,10" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
