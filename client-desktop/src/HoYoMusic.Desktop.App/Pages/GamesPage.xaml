<Page
    x:Class="HoYoMusic.Desktop.App.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource Gap2XL}" Padding="4,0,12,32">

            <!-- Section Header -->
            <StackPanel Spacing="{StaticResource GapLG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="&#x6E38;&#x620F;&#x5217;&#x8868;" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Grid>
                    <Border Style="{StaticResource CardShadowStyle}" />
                    <Border Style="{StaticResource GlassCardStyle}">
                        <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                  Style="{StaticResource TrackListStyle}" Padding="{StaticResource PaddingSM}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="{StaticResource Gap14}" Margin="4,4,4,4" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource RadiusMD}" Background="{StaticResource CoverPlaceholderBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE7FC;" FontSize="{StaticResource IconCoverPlaceholderSmall}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border CornerRadius="{StaticResource RadiusMD}">
                                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="{StaticResource PaddingSM}" CornerRadius="{StaticResource RadiusSM}" Background="{StaticResource PrimarySubtleBrush}" VerticalAlignment="Center">
                                            <TextBlock FontSize="{StaticResource FontSmall}" Foreground="{StaticResource PrimaryBrush}">
                                                <Run Text="{Binding AlbumCount}" /><Run Text=" &#x4E13;&#x8F91;" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
