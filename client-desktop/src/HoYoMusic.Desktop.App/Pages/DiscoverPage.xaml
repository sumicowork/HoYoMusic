<Page
    x:Class="HoYoMusic.Desktop.App.Pages.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource Gap2XL}" Padding="4,0,12,32">

            <!-- Hero Banner -->
            <Border Style="{StaticResource HeroCardStyle}" MinHeight="160">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource GapSM}" VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontDisplay}" FontWeight="Bold"
                                   Foreground="{StaticResource TextInverseBrush}" Text="&#x53D1;&#x73B0;&#x97F3;&#x4E50;" />
                        <TextBlock FontSize="{StaticResource FontSubtitleLG}" Foreground="#CCFFFFFF"
                                   Text="&#x6D4F;&#x89C8;&#x6E38;&#x620F;&#x539F;&#x58F0;&#x3001;&#x4E13;&#x8F91;&#x4E0E;&#x7CBE;&#x9009;&#x66F2;&#x76EE;" TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapLG}" Margin="0,8,0,0">
                            <StackPanel Spacing="{StaticResource Gap2}">
                                <TextBlock FontSize="{StaticResource FontTitle}" FontWeight="Bold" Foreground="{StaticResource TextInverseBrush}"
                                           Text="{Binding Games.Count, FallbackValue=0}" />
                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="#99FFFFFF" Text="&#x6E38;&#x620F;" />
                            </StackPanel>
                            <Border Width="1" Background="#33FFFFFF" Margin="0,4,0,4" />
                            <StackPanel Spacing="{StaticResource Gap2}">
                                <TextBlock FontSize="{StaticResource FontTitle}" FontWeight="Bold" Foreground="{StaticResource TextInverseBrush}"
                                           Text="{Binding SelectedGameAlbums.Count, FallbackValue=0}" />
                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="#99FFFFFF" Text="&#x4E13;&#x8F91;" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE8D4;" FontSize="80" Foreground="#15FFFFFF"
                              VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                </Grid>
            </Border>

            <!-- Game Selector -->
            <StackPanel Spacing="{StaticResource GapLG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="&#x9009;&#x62E9;&#x6E38;&#x620F;" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Grid>
                    <Border Style="{StaticResource CardShadowStyle}" />
                    <Border Style="{StaticResource GlassCardStyle}">
                        <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                  Style="{StaticResource TrackListStyle}" MaxHeight="200" Padding="{StaticResource PaddingSM}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="{StaticResource Gap14}" Margin="4,4,4,4" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusMD}" Background="{StaticResource CoverPlaceholderBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE7FC;" FontSize="{StaticResource IconCoverPlaceholderSmall}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border CornerRadius="{StaticResource RadiusMD}">
                                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Albums Section -->
            <StackPanel Spacing="{StaticResource GapLG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="&#x4E13;&#x8F91;" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <ListView ItemsSource="{Binding SelectedGameAlbums}" SelectedItem="{Binding SelectedGameAlbum, Mode=TwoWay}"
                          SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AlbumItem_Click"
                          Style="{StaticResource TrackListStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="180" Margin="0,0,14,0">
                                <Border Style="{StaticResource CardShadowStyle}" />
                                <Border Style="{StaticResource GlassCardStyle}" Padding="0,0,0,10">
                                    <StackPanel Spacing="{StaticResource Gap6}">
                                        <Border CornerRadius="{StaticResource RadiusMD}" Height="164" Background="{StaticResource CoverPlaceholderBrush}" Margin="8,8,8,2">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconCoverPlaceholderLarge}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border CornerRadius="{StaticResource RadiusMD}">
                                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="10,0,10,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Tracks: Random + Top side by side -->
            <StackPanel Spacing="{StaticResource GapLG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="&#x63A8;&#x8350;&#x66F2;&#x76EE;" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="{StaticResource GapLG}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Random tracks card -->
                    <Grid>
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel Padding="{StaticResource PaddingXL}" Spacing="{StaticResource GapMD}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                    <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource PrimarySubtleBrush}">
                                        <FontIcon Glyph="&#xE8B1;" FontSize="12" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="&#x968F;&#x673A;&#x63A8;&#x8350;" FontSize="{StaticResource FontSubtitleSM}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ListView ItemsSource="{Binding RandomTracksView}" Style="{StaticResource TrackListStyle}" MaxHeight="320"
                                          IsItemClickEnabled="True" ItemClick="RandomTrack_Click">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,2,2,2" MinHeight="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Stretch" Margin="0,6,0,6" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AlbumTitle}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Top tracks card -->
                    <Grid Grid.Column="1">
                        <Border Style="{StaticResource CardShadowStyle}" />
                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel Padding="{StaticResource PaddingXL}" Spacing="{StaticResource GapMD}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                    <Border Width="24" Height="24" CornerRadius="{StaticResource RadiusFull}" Background="{StaticResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="&#x70ED;&#x95E8;&#x66F2;&#x76EE;" FontSize="{StaticResource FontSubtitleSM}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ListView ItemsSource="{Binding TopTracksView}" Style="{StaticResource TrackListStyle}" MaxHeight="320"
                                          IsItemClickEnabled="True" ItemClick="TopTrack_Click">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,2,2,2" MinHeight="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}" VerticalAlignment="Stretch" Margin="0,6,0,6" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AlbumTitle}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
