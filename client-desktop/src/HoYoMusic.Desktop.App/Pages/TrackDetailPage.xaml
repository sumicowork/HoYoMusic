<Page
    x:Class="HoYoMusic.Desktop.App.Pages.TrackDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource Gap2XL}" Padding="4,0,12,32">

            <!-- Back Button -->
            <Button Click="Back_Click" Style="{StaticResource GhostButtonStyle}" Padding="{StaticResource PaddingMD}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="&#x8FD4;&#x56DE;" FontSize="{StaticResource FontBody}" />
                </StackPanel>
            </Button>

            <!-- Track Hero Card -->
            <Border Style="{StaticResource HeroCardStyle}" Padding="{StaticResource Padding3XL}">
                <Grid ColumnSpacing="{StaticResource GapXL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="120" Height="120" CornerRadius="{StaticResource RadiusLG}" Background="{StaticResource CoverPlaceholderBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconHeroSize}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="{StaticResource RadiusLG}">
                                <Image Source="{Binding CurrentDetailTrack.CoverPath}" Stretch="UniformToFill" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource GapMD}">
                        <TextBlock Text="{Binding CurrentDetailTrack.Title, FallbackValue='&#x66F2;&#x76EE;&#x8BE6;&#x60C5;'}" FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                                   Foreground="{StaticResource TextInverseBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding CurrentDetailTrack.ArtistsDisplay, FallbackValue='--'}" FontSize="{StaticResource FontSubtitle}"
                                   Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapLG}">
                            <TextBlock Text="{Binding CurrentDetailTrack.AlbumTitle, FallbackValue='--'}" FontSize="{StaticResource FontCaption}" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentDetailTrack.DurationDisplay, FallbackValue='--:--'}" FontSize="{StaticResource FontCaption}" Foreground="#99FFFFFF" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Buttons Row -->
            <Grid>
                <Border Style="{StaticResource CardShadowStyle}" />
                <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapMD}">
                        <Button Command="{Binding PlayCurrentDetailTrackCommand}" Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="&#x64AD;&#x653E;" FontSize="{StaticResource FontBody}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleFavoriteForCurrentDetailTrackCommand}" Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                <FontIcon Glyph="&#xEB52;" FontSize="14" />
                                <TextBlock Text="&#x6536;&#x85CF;" FontSize="{StaticResource FontBody}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddCurrentDetailTrackToPlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="&#x52A0;&#x5165;&#x6B4C;&#x5355;" FontSize="{StaticResource FontBody}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DownloadCurrentDetailTrackCommand}" Style="{StaticResource GhostButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="&#x4E0B;&#x8F7D;" FontSize="{StaticResource FontBody}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Lyrics Preview Card -->
            <StackPanel Spacing="{StaticResource GapLG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="&#x6B4C;&#x8BCD;" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Grid>
                    <Border Style="{StaticResource CardShadowStyle}" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                        <TextBlock Text="{Binding DetailLyricsPreview}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" LineHeight="{StaticResource LineHeightSubtitle}" />
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Credits Summary Card -->
            <StackPanel Spacing="{StaticResource GapLG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="&#x5236;&#x4F5C;&#x4EBA;&#x5458;" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Grid>
                    <Border Style="{StaticResource CardShadowStyle}" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                        <TextBlock Text="{Binding DetailCreditsSummary}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Music Sources Summary Card -->
            <StackPanel Spacing="{StaticResource GapLG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="&#x97F3;&#x4E50;&#x6765;&#x6E90;" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Grid>
                    <Border Style="{StaticResource CardShadowStyle}" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="{StaticResource PaddingXL}">
                        <TextBlock Text="{Binding DetailMusicSourcesSummary}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
