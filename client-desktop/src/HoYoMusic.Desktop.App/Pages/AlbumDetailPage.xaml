<Page
    x:Class="HoYoMusic.Desktop.App.Pages.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource Gap2XL}" Padding="4,0,12,32">

            <!-- Back Button -->
            <Button Click="Back_Click" Style="{StaticResource GhostButtonStyle}" Padding="{StaticResource PaddingMD}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="&#x8FD4;&#x56DE;" FontSize="{StaticResource FontBody}" />
                </StackPanel>
            </Button>

            <!-- Album Hero Card -->
            <Border Style="{StaticResource HeroCardStyle}" Padding="{StaticResource Padding3XL}">
                <Grid ColumnSpacing="{StaticResource GapXL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="120" Height="120" CornerRadius="{StaticResource RadiusLG}" Background="{StaticResource CoverPlaceholderBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D4;" FontSize="{StaticResource IconHeroSize}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="{StaticResource RadiusLG}">
                                <Image Source="{Binding CurrentAlbum.CoverPath}" Stretch="UniformToFill" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource GapMD}">
                        <TextBlock Text="{Binding CurrentAlbum.Title, FallbackValue='&#x4E13;&#x8F91;&#x8BE6;&#x60C5;'}" FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                                   Foreground="{StaticResource TextInverseBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapLG}">
                            <TextBlock FontSize="{StaticResource FontCaption}" Foreground="#99FFFFFF">
                                <Run Text="{Binding CurrentAlbum.TrackCount}" /><Run Text=" &#x9996;&#x66F2;&#x76EE;" />
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource FontCaption}" Foreground="#99FFFFFF"
                                       Text="{Binding CurrentAlbum.ReleaseDate, FallbackValue='--'}" />
                        </StackPanel>
                        <Button Command="{Binding PlayAlbumAllCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSM}">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="&#x64AD;&#x653E;&#x5168;&#x90E8;" FontSize="{StaticResource FontBody}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Track List -->
            <StackPanel Spacing="{StaticResource GapLG}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="18" CornerRadius="1.5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="&#x66F2;&#x76EE;&#x5217;&#x8868;" FontSize="{StaticResource FontSubtitleLG}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Grid>
                    <Border Style="{StaticResource CardShadowStyle}" />
                    <Border Style="{StaticResource GlassCardStyle}">
                        <ListView ItemsSource="{Binding AlbumTrackRows}"
                                  Style="{StaticResource TrackListStyle}" Padding="{StaticResource PaddingSM}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="TrackItem_Click">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4,4,4" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PlayingIndicator}" FontSize="{StaticResource FontBody}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArtistsDisplay}" FontSize="{StaticResource FontSmall}" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding DurationDisplay}" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
