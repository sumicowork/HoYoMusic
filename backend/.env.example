# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hoyomusic
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE=524288000

# ==========================================
# 存储模式选择（必填）
# ==========================================
# 可选值: local | webdav | oss
STORAGE_MODE=local

# 本地存储目录（仅 STORAGE_MODE=local 时有效）
UPLOAD_DIR=./uploads

# ==========================================
# 阿里云 OSS 配置（STORAGE_MODE=oss 时必填）
# ==========================================
#
# 地域（Region）标识符，示例：
#   oss-cn-hangzhou  (华东1·杭州)
#   oss-cn-shanghai  (华东2·上海)
#   oss-cn-beijing   (华北2·北京)
#   oss-cn-shenzhen  (华南1·深圳)
# 完整列表：https://help.aliyun.com/document_detail/31837.html
OSS_REGION=oss-cn-hangzhou

# RAM 子账号 AccessKey（推荐使用最小权限 RAM 子账号，不要使用主账号）
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# Bucket 名称
OSS_BUCKET=your_bucket_name

# 自定义 Endpoint（可选，留空则使用 <region>.aliyuncs.com 默认域名）
# 内网传输（ECS 同地域）：oss-cn-hangzhou-internal.aliyuncs.com
# OSS_ENDPOINT=

# 自定义 CDN 加速域名（可选，绑定 CDN 后填写，例如 cdn.example.com）
# 留空则直接使用 OSS 默认域名
# OSS_CDN_DOMAIN=cdn.example.com

# 是否使用 HTTPS（默认 true，生产环境强烈建议开启）
OSS_SECURE=true

# OSS 内文件路径前缀（应用目录，无需斜杠）
OSS_BASE_PATH=hoyomusic

# ==========================================
# WebDAV远程存储配置（STORAGE_MODE=webdav 时必填）
# ==========================================
WEBDAV_URL=http://localhost:8080/webdav
WEBDAV_USERNAME=admin
WEBDAV_PASSWORD=admin
WEBDAV_BASE_PATH=/hoyomusic
WEBDAV_PUBLIC_URL=http://localhost:8080/webdav/hoyomusic

# ==========================================
# 高危调试接口（默认关闭，生产慎用）
# ==========================================
# 启用开关（默认 false）
DEBUG_API_ENABLED=false

# 调试 JWT 密钥（建议至少 64 字符随机串）
DEBUG_JWT_SECRET=
DEBUG_JWT_ISSUER=hoyomusic-debug
DEBUG_JWT_AUDIENCE=hoyomusic-debug-client

# 请求签名密钥（建议至少 64 字符随机串）
DEBUG_HMAC_SECRET=

# 允许访问的 IP 白名单（逗号分隔，留空表示不限制）
# DEBUG_ALLOWED_IPS=127.0.0.1,10.0.0.5

# 时间戳与 nonce 防重放配置
DEBUG_MAX_SKEW_MS=30000
DEBUG_NONCE_TTL_MS=300000

# 调试接口可访问的项目根目录（默认 backend 上一级目录）
# DEBUG_ROOT_DIR=/opt/HoYoMusic

# 单次文件读取最大字节（默认 1MB）
DEBUG_MAX_READ_BYTES=1048576

# 是否允许执行写入 SQL（默认 false）
DEBUG_ALLOW_WRITE_SQL=false

# ==========================================
# 配置示例 - 阿里云 OSS
# ==========================================
#
# STORAGE_MODE=oss
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=LTAI5tXxxxxxxxxxxxxxxxxx
# OSS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OSS_BUCKET=hoyomusic-prod
# OSS_CDN_DOMAIN=cdn.yourdomain.com   # 可选
# OSS_SECURE=true
# OSS_BASE_PATH=hoyomusic
#
# ==========================================
# 配置示例 - WebDAV（坚果云）
# ==========================================
#
# STORAGE_MODE=webdav
# WEBDAV_URL=https://dav.jianguoyun.com/dav
# WEBDAV_USERNAME=your_email@example.com
# WEBDAV_PASSWORD=your_app_password
# WEBDAV_BASE_PATH=/hoyomusic
# WEBDAV_PUBLIC_URL=https://dav.jianguoyun.com/dav/hoyomusic
#
# ==========================================
